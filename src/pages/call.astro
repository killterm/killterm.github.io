---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="P2P 화상 통화 — Killterm"
  description="시그널링 서버 없이 코드 교환만으로 연결하는 1:1 P2P 화상 통화."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>📞 P2P 화상 통화</h1>
      <p>
        시그널링 서버 없이, 연결 코드를 메신저로 주고받아 1:1로 연결합니다. 영상·음성은
        WebRTC 표준 암호화(DTLS-SRTP)로 <b>브라우저 간 직접</b> 전송되며 이 사이트의 서버를
        거치지 않습니다 (서버가 없기도 합니다).
      </p>
      <p class="hint">
        연결 주소 탐색에 구글 공개 STUN 서버를 사용합니다. 중계(TURN) 서버는 없으므로
        일부 네트워크(대칭 NAT·엄격한 방화벽)에서는 연결되지 않을 수 있습니다.
      </p>
    </header>

    <!-- 1단계: 역할 선택 -->
    <section class="step" id="step-role">
      <button id="role-host" class="role-btn" type="button">
        <span class="role-title">📞 방 만들기</span>
        <span class="role-desc">초대하는 쪽 — 초대 코드를 만들어 상대에게 보냅니다</span>
      </button>
      <button id="role-guest" class="role-btn" type="button">
        <span class="role-title">📩 초대 코드가 있어요</span>
        <span class="role-desc">받는 쪽 — 받은 코드를 붙여넣고 응답 코드를 돌려줍니다</span>
      </button>
    </section>

    <!-- 2단계: 코드 교환 -->
    <section class="step exchange" id="step-exchange" hidden>
      <div class="code-box" id="box-mine" hidden>
        <h2 id="mine-title">내 초대 코드</h2>
        <p class="hint" id="mine-hint">이 코드를 카카오톡 등 메신저로 상대에게 보내세요.</p>
        <textarea id="code-mine" rows="4" readonly spellcheck="false"></textarea>
        <div class="row">
          <button class="btn btn-small copy" data-target="code-mine" type="button">복사</button>
        </div>
        <canvas id="qr-mine" class="qr" hidden></canvas>
      </div>

      <div class="code-box" id="box-theirs">
        <h2 id="theirs-title">상대 코드 붙여넣기</h2>
        <p class="hint" id="theirs-hint"></p>
        <textarea id="code-theirs" rows="4" spellcheck="false" placeholder="kc1:…"></textarea>
        <div class="row">
          <button id="exchange-action" class="btn btn-primary" type="button">연결</button>
        </div>
      </div>

      <p id="exchange-status" class="status" role="status"></p>
    </section>

    <!-- 통화 화면 -->
    <section class="step call" id="step-call" hidden>
      <div class="videos">
        <video id="video-remote" autoplay playsinline></video>
        <video id="video-local" autoplay playsinline muted></video>
        <p class="video-waiting" id="video-waiting">상대 연결을 기다리는 중…</p>
      </div>
      <div class="row controls">
        <span class="conn" id="conn-state">준비</span>
        <button id="ctl-mic" class="btn" type="button">🎙️ 마이크 끄기</button>
        <button id="ctl-cam" class="btn" type="button">📷 카메라 끄기</button>
        <button id="ctl-hangup" class="btn btn-danger" type="button">통화 종료</button>
      </div>

      <div class="chat">
        <div class="chat-log" id="chat-log" aria-label="채팅"></div>
        <div class="row">
          <input id="chat-input" type="text" placeholder="메시지 (연결 후 사용 가능)" disabled />
          <button id="chat-send" class="btn btn-small" type="button" disabled>보내기</button>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  import QRCode from 'qrcode';
  import { encodeSignal, decodeSignal } from '../lib/sdp-code';
  import { setupCopyButtons } from '../lib/copy-buttons';

  setupCopyButtons();

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const stepRole = el<HTMLElement>('step-role');
  const stepExchange = el<HTMLElement>('step-exchange');
  const stepCall = el<HTMLElement>('step-call');
  const boxMine = el<HTMLDivElement>('box-mine');
  const mineTitle = el<HTMLHeadingElement>('mine-title');
  const mineHint = el<HTMLParagraphElement>('mine-hint');
  const theirsTitle = el<HTMLHeadingElement>('theirs-title');
  const theirsHint = el<HTMLParagraphElement>('theirs-hint');
  const codeMine = el<HTMLTextAreaElement>('code-mine');
  const codeTheirs = el<HTMLTextAreaElement>('code-theirs');
  const qrMine = el<HTMLCanvasElement>('qr-mine');
  const exchangeAction = el<HTMLButtonElement>('exchange-action');
  const exchangeStatus = el<HTMLParagraphElement>('exchange-status');
  const videoRemote = el<HTMLVideoElement>('video-remote');
  const videoLocal = el<HTMLVideoElement>('video-local');
  const videoWaiting = el<HTMLParagraphElement>('video-waiting');
  const connState = el<HTMLSpanElement>('conn-state');
  const micButton = el<HTMLButtonElement>('ctl-mic');
  const camButton = el<HTMLButtonElement>('ctl-cam');
  const chatLog = el<HTMLDivElement>('chat-log');
  const chatInput = el<HTMLInputElement>('chat-input');
  const chatSend = el<HTMLButtonElement>('chat-send');

  let pc: RTCPeerConnection | null = null;
  let localStream: MediaStream | null = null;
  let chatChannel: RTCDataChannel | null = null;
  let role: 'host' | 'guest' = 'host';

  const setStatus = (message: string) => {
    exchangeStatus.textContent = message;
  };

  function describeMediaError(e: unknown): string {
    if (e instanceof DOMException) {
      if (e.name === 'NotAllowedError') return '카메라/마이크 권한이 거부되었습니다. 브라우저 설정에서 허용해주세요.';
      if (e.name === 'NotFoundError') return '사용할 수 있는 카메라/마이크가 없습니다.';
      if (e.name === 'NotReadableError') return '카메라/마이크가 다른 프로그램에서 사용 중입니다.';
    }
    return `장치를 시작하지 못했습니다: ${e instanceof Error ? e.message : String(e)}`;
  }

  // ---------- WebRTC 공통 ----------

  async function setupMedia(): Promise<boolean> {
    try {
      localStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: true });
    } catch (e) {
      setStatus(describeMediaError(e));
      return false;
    }
    videoLocal.srcObject = localStream;
    stepCall.hidden = false;
    return true;
  }

  function createPeer(): RTCPeerConnection {
    const peer = new RTCPeerConnection({
      iceServers: [{ urls: 'stun:stun.l.google.com:19302' }],
    });
    for (const track of localStream!.getTracks()) {
      peer.addTrack(track, localStream!);
    }
    peer.addEventListener('track', (e) => {
      videoRemote.srcObject = e.streams[0];
      videoWaiting.hidden = true;
    });
    peer.addEventListener('connectionstatechange', () => {
      const state = peer.connectionState;
      const labels: Record<string, string> = {
        new: '준비',
        connecting: '연결 중…',
        connected: '연결됨 ✅',
        disconnected: '연결 끊김',
        failed: '연결 실패',
        closed: '종료됨',
      };
      connState.textContent = labels[state] ?? state;
      if (state === 'connected') {
        stepExchange.hidden = true;
        setStatus('');
      }
      if (state === 'failed') {
        setStatus('연결에 실패했습니다. 양쪽 네트워크가 P2P를 허용하지 않을 수 있습니다 (TURN 서버 없음).');
        stepExchange.hidden = false;
      }
    });
    return peer;
  }

  // 수동 시그널링이라 trickle ICE를 쓸 수 없어, 후보 수집이 끝난 SDP를 통째로 교환한다
  function waitIceComplete(peer: RTCPeerConnection): Promise<void> {
    if (peer.iceGatheringState === 'complete') return Promise.resolve();
    return new Promise((resolve) => {
      const check = () => {
        if (peer.iceGatheringState === 'complete') {
          peer.removeEventListener('icegatheringstatechange', check);
          resolve();
        }
      };
      peer.addEventListener('icegatheringstatechange', check);
      // 일부 환경에서 complete 이벤트가 늦거나 안 오므로 안전장치
      setTimeout(resolve, 4000);
    });
  }

  async function showMyCode(description: RTCSessionDescription) {
    const code = await encodeSignal({ type: description.type, sdp: description.sdp });
    codeMine.value = code;
    boxMine.hidden = false;
    try {
      await QRCode.toCanvas(qrMine, code, { errorCorrectionLevel: 'L', margin: 1, width: 220 });
      qrMine.hidden = false;
    } catch {
      // 코드가 QR 용량을 넘으면 QR만 생략하고 텍스트로 교환
      qrMine.hidden = true;
    }
  }

  async function parseTheirCode(expected: 'offer' | 'answer') {
    const raw = codeTheirs.value.trim();
    if (raw === '') {
      throw new Error('상대 코드를 붙여넣어주세요.');
    }
    const signal = (await decodeSignal(raw)) as { type?: string; sdp?: string };
    if (signal?.type !== expected || typeof signal.sdp !== 'string') {
      throw new Error(
        expected === 'offer'
          ? '초대 코드가 아닙니다. 방을 만든 쪽의 코드를 붙여넣어주세요.'
          : '응답 코드가 아닙니다. 초대를 받은 쪽의 코드를 붙여넣어주세요.',
      );
    }
    return new RTCSessionDescription({ type: signal.type, sdp: signal.sdp });
  }

  // ---------- 채팅 (DataChannel) ----------

  function appendChat(kind: 'me' | 'peer' | 'system', text: string) {
    const row = document.createElement('div');
    row.className = `chat-row chat-${kind}`;
    row.textContent = kind === 'me' ? `나: ${text}` : kind === 'peer' ? `상대: ${text}` : text;
    chatLog.appendChild(row);
    chatLog.scrollTop = chatLog.scrollHeight;
  }

  function wireChatChannel(channel: RTCDataChannel) {
    chatChannel = channel;
    channel.addEventListener('open', () => {
      chatInput.disabled = false;
      chatSend.disabled = false;
      appendChat('system', '채팅이 연결되었습니다.');
    });
    channel.addEventListener('close', () => {
      chatInput.disabled = true;
      chatSend.disabled = true;
      appendChat('system', '채팅 연결이 종료되었습니다.');
    });
    channel.addEventListener('message', (e) => appendChat('peer', String(e.data)));
  }

  function sendChat() {
    const text = chatInput.value.trim();
    if (text === '' || chatChannel?.readyState !== 'open') return;
    chatChannel.send(text);
    appendChat('me', text);
    chatInput.value = '';
  }

  chatSend.addEventListener('click', sendChat);
  chatInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') sendChat();
  });

  // ---------- 역할별 흐름 ----------

  el<HTMLButtonElement>('role-host').addEventListener('click', async () => {
    role = 'host';
    stepRole.hidden = true;
    stepExchange.hidden = false;
    mineTitle.textContent = '① 내 초대 코드';
    mineHint.textContent = '이 코드를 메신저로 상대에게 보내세요.';
    theirsTitle.textContent = '② 상대의 응답 코드 붙여넣기';
    theirsHint.textContent = '상대가 돌려준 응답 코드를 붙여넣고 [연결]을 누르세요.';
    exchangeAction.textContent = '연결';
    setStatus('카메라·마이크를 시작하고 초대 코드를 만드는 중…');

    if (!(await setupMedia())) return;
    pc = createPeer();
    wireChatChannel(pc.createDataChannel('chat'));
    await pc.setLocalDescription(await pc.createOffer());
    await waitIceComplete(pc);
    await showMyCode(pc.localDescription!);
    setStatus('');
  });

  el<HTMLButtonElement>('role-guest').addEventListener('click', () => {
    role = 'guest';
    stepRole.hidden = true;
    stepExchange.hidden = false;
    stepExchange.classList.add('guest');
    theirsTitle.textContent = '① 받은 초대 코드 붙여넣기';
    theirsHint.textContent = '상대가 보낸 초대 코드를 붙여넣고 [응답 코드 만들기]를 누르세요.';
    mineTitle.textContent = '② 내 응답 코드';
    mineHint.textContent = '이 코드를 상대에게 돌려보내면 연결이 시작됩니다.';
    exchangeAction.textContent = '응답 코드 만들기';
  });

  exchangeAction.addEventListener('click', async () => {
    setStatus('');
    try {
      if (role === 'host') {
        const answer = await parseTheirCode('answer');
        await pc!.setRemoteDescription(answer);
        setStatus('연결 중…');
      } else {
        const offer = await parseTheirCode('offer');
        setStatus('카메라·마이크를 시작하고 응답 코드를 만드는 중…');
        if (!(await setupMedia())) return;
        pc = createPeer();
        pc.addEventListener('datachannel', (e) => wireChatChannel(e.channel));
        await pc.setRemoteDescription(offer);
        await pc.setLocalDescription(await pc.createAnswer());
        await waitIceComplete(pc);
        await showMyCode(pc.localDescription!);
        setStatus('응답 코드를 상대에게 보내면 곧 연결됩니다.');
      }
    } catch (e) {
      setStatus(e instanceof Error ? e.message : String(e));
    }
  });

  // ---------- 통화 컨트롤 ----------

  function toggleTrack(kind: 'audio' | 'video', button: HTMLButtonElement, labels: [string, string]) {
    const track = localStream?.getTracks().find((t) => t.kind === kind);
    if (!track) return;
    track.enabled = !track.enabled;
    button.textContent = track.enabled ? labels[0] : labels[1];
  }

  micButton.addEventListener('click', () => {
    toggleTrack('audio', micButton, ['🎙️ 마이크 끄기', '🔇 마이크 켜기']);
  });
  camButton.addEventListener('click', () => {
    toggleTrack('video', camButton, ['📷 카메라 끄기', '🚫 카메라 켜기']);
  });

  function hangup() {
    chatChannel?.close();
    pc?.close();
    if (localStream) {
      for (const track of localStream.getTracks()) track.stop();
    }
    // 상태가 많아 새로 시작하는 것이 가장 안전하다
    location.reload();
  }

  el<HTMLButtonElement>('ctl-hangup').addEventListener('click', hangup);
  window.addEventListener('pagehide', () => {
    pc?.close();
    if (localStream) {
      for (const track of localStream.getTracks()) track.stop();
    }
  });
</script>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .intro p {
    color: var(--text-dim);
    margin: 0 0 0.6rem;
  }

  .intro b {
    color: var(--text);
  }

  .step {
    margin-top: 1.5rem;
  }

  /* ---------- 역할 선택 ---------- */

  #step-role {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1rem;
  }

  .role-btn {
    display: grid;
    gap: 0.4rem;
    padding: 1.4rem 1.5rem;
    text-align: left;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 1rem;
    cursor: pointer;
    font: inherit;
    color: var(--text);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }

  .role-btn:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .role-title {
    font-size: 1.1rem;
    font-weight: 700;
  }

  .role-desc {
    color: var(--text-dim);
    font-size: 0.88rem;
  }

  /* ---------- 코드 교환 ---------- */

  .exchange {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  /* 받는 쪽은 "상대 코드 붙여넣기"가 먼저 온다 */
  .exchange.guest #box-theirs {
    order: -1;
  }

  .code-box {
    display: grid;
    gap: 0.5rem;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    padding: 1rem 1.2rem;
  }

  .code-box h2 {
    margin: 0;
    font-size: 1rem;
  }

  .code-box textarea {
    width: 100%;
    resize: vertical;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.8rem;
    line-height: 1.4;
    padding: 0.6rem 0.75rem;
    border-radius: 0.6rem;
    overflow-wrap: anywhere;
  }

  .code-box textarea:focus {
    outline: 2px solid var(--accent);
    border-color: var(--accent);
  }

  .qr {
    justify-self: start;
    border-radius: 0.5rem;
    background: #fff;
    padding: 6px;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  /* ---------- 통화 화면 ---------- */

  .videos {
    position: relative;
    background: #0a0c10;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  #video-remote {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #video-local {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    width: clamp(120px, 22%, 220px);
    border-radius: 0.6rem;
    border: 1px solid rgba(255, 255, 255, 0.3);
    background: #000;
  }

  .video-waiting {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    pointer-events: none;
  }

  .video-waiting[hidden] {
    display: none;
  }

  .controls {
    margin-top: 0.8rem;
  }

  .conn {
    font-size: 0.9rem;
    font-weight: 700;
    margin-right: auto;
  }

  /* ---------- 채팅 ---------- */

  .chat {
    margin-top: 1rem;
    display: grid;
    gap: 0.5rem;
  }

  .chat-log {
    min-height: 90px;
    max-height: 200px;
    overflow-y: auto;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    padding: 0.6rem 0.8rem;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .chat-log:empty::before {
    content: '채팅 메시지가 여기에 표시됩니다';
    color: var(--text-dim);
  }

  /* 채팅 행은 JS로 생성되므로 :global로 선언 */
  .chat-log :global(.chat-me) {
    color: var(--accent);
  }

  .chat-log :global(.chat-system) {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  .chat input {
    flex: 1;
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text);
    font: inherit;
    font-size: 0.9rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
  }

  .chat input:focus {
    outline: 2px solid var(--accent);
    border-color: var(--accent);
  }

  /* ---------- 공용 ---------- */

  .btn {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 0.7rem;
    cursor: pointer;
  }

  .btn:hover {
    border-color: var(--accent);
  }

  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-danger {
    border-color: var(--danger);
    color: var(--danger);
  }

  .btn-small {
    padding: 0.3rem 0.7rem;
    font-size: 0.82rem;
  }

  .hint {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin: 0;
  }

  .status {
    min-height: 1.2em;
    margin: 0;
    font-size: 0.88rem;
    color: var(--danger);
    overflow-wrap: anywhere;
  }
</style>
