---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="이미지 편집 — Killterm"
  description="레이어 합성·이동·스케일, 자르기, 캔버스 리사이즈, WebP/PNG/JPG 내보내기, EXIF 확인을 브라우저 안에서 처리합니다."
>
  <main>
    <header class="editor-header">
      <a class="home" href="/">← 홈으로</a>
      <h1>🖼️ 이미지 편집</h1>
      <span class="note">이미지는 브라우저 밖으로 전송되지 않으며, 내보낸 파일에는 EXIF가 포함되지 않습니다.</span>
    </header>

    <div class="editor">
      <!-- 좌측 툴바 -->
      <nav class="toolbar" aria-label="도구">
        <button id="tool-move" class="tool active" type="button" title="이동 (V)">✥</button>
        <button id="tool-crop" class="tool" type="button" title="자르기 (C)">⬚</button>
        <button id="tool-text" class="tool" type="button" title="텍스트 (T)">T</button>
        <span class="toolbar-divider" aria-hidden="true"></span>
        <button id="history-undo" class="tool" type="button" title="실행 취소 (Ctrl+Z)" disabled>↶</button>
        <button id="history-redo" class="tool" type="button" title="다시 실행 (Ctrl+Shift+Z)" disabled>↷</button>
      </nav>

      <!-- 캔버스 영역 -->
      <div class="workspace">
        <div class="context-bar" id="context-bar">
          <span id="context-hint" class="context-hint">이미지를 추가하면 편집을 시작할 수 있습니다.</span>
          <div class="crop-options" id="crop-options" hidden>
            <div class="chip-group" role="radiogroup" aria-label="자르기 비율">
              <label class="chip">
                <input type="radio" name="crop-ratio" value="free" checked />
                <span>자유</span>
              </label>
              <label class="chip">
                <input type="radio" name="crop-ratio" value="1" />
                <span>1:1</span>
              </label>
              <label class="chip">
                <input type="radio" name="crop-ratio" value={String(4 / 3)} />
                <span>4:3</span>
              </label>
              <label class="chip">
                <input type="radio" name="crop-ratio" value={String(16 / 9)} />
                <span>16:9</span>
              </label>
              <label class="chip">
                <input type="radio" name="crop-ratio" value={String(9 / 16)} />
                <span>9:16</span>
              </label>
            </div>
            <button id="crop-apply" class="btn btn-small btn-primary" type="button" disabled>
              자르기 적용
            </button>
            <button id="crop-cancel" class="btn btn-small" type="button" disabled>
              선택 해제 (Esc)
            </button>
          </div>
          <div class="text-options" id="text-options" hidden>
            <input id="text-content" type="text" placeholder="삽입할 텍스트" />
            <label class="num-field">
              크기
              <input id="text-size" type="number" min="8" max="512" step="1" value="48" />
            </label>
            <input id="text-color" type="color" value="#ffffff" aria-label="글자색" />
            <button id="text-update" class="btn btn-small" type="button" disabled>
              선택한 텍스트 수정
            </button>
          </div>
        </div>

        <div class="canvas-area" id="canvas-area">
          <div class="doc-stack" id="doc-stack" hidden>
            <canvas id="doc-canvas"></canvas>
            <canvas id="doc-overlay"></canvas>
          </div>
          <p class="drop-guide" id="drop-guide">
            이미지를 여기에 드래그하거나 붙여넣기(Ctrl+V)하세요.<br />
            추가하는 이미지마다 새 레이어가 됩니다.
          </p>
        </div>
      </div>

      <!-- 우측 패널 -->
      <aside class="panel">
        <section class="panel-section">
          <h2>레이어</h2>
          <div class="layer-list" id="layer-list"></div>
          <div class="panel-row">
            <button id="layer-up" class="btn btn-small" type="button" title="위로">↑</button>
            <button id="layer-down" class="btn btn-small" type="button" title="아래로">↓</button>
            <button id="layer-delete" class="btn btn-small" type="button" title="삭제">🗑</button>
            <button id="layer-add" class="btn btn-small btn-primary" type="button">이미지 추가</button>
          </div>
          <input id="layer-file" type="file" accept="image/*" multiple hidden />
        </section>

        <section class="panel-section">
          <h2>캔버스</h2>
          <div class="panel-row">
            <label class="num-field">
              폭
              <input id="doc-width" type="number" min="1" max="20000" step="1" />
            </label>
            <label class="num-field">
              높이
              <input id="doc-height" type="number" min="1" max="20000" step="1" />
            </label>
          </div>
          <div class="panel-row">
            <label class="check-field">
              <input type="checkbox" id="doc-ratio" checked />
              비율 유지
            </label>
            <button id="doc-resize" class="btn btn-small" type="button">리사이즈 적용</button>
          </div>
          <p class="hint">캔버스와 모든 레이어가 함께 스케일됩니다.</p>
        </section>

        <section class="panel-section">
          <h2>내보내기</h2>
          <div class="chip-group" role="radiogroup" aria-label="출력 형식">
            <label class="chip">
              <input type="radio" name="export-format" value="image/png" checked />
              <span>PNG</span>
            </label>
            <label class="chip">
              <input type="radio" name="export-format" value="image/jpeg" />
              <span>JPG</span>
            </label>
            <label class="chip">
              <input type="radio" name="export-format" value="image/webp" />
              <span>WebP</span>
            </label>
          </div>
          <div class="panel-row">
            <label class="num-field">
              품질
              <input id="export-quality" type="number" min="1" max="100" step="1" value="90" disabled />
            </label>
            <button id="export-download" class="btn btn-small btn-primary" type="button">다운로드</button>
          </div>
          <p class="hint">보이는 레이어를 합성해 내보냅니다 (EXIF 제거됨).</p>
        </section>

        <section class="panel-section">
          <details id="exif-details">
            <summary>EXIF (활성 레이어)</summary>
            <div class="exif-card" id="exif-card">레이어를 선택하세요.</div>
          </details>
        </section>
      </aside>
    </div>

    <footer class="status-bar">
      <span id="status-doc">캔버스 없음</span>
      <span id="status-layer"></span>
      <span id="status-message" class="status-message" role="status"></span>
    </footer>
  </main>
</Layout>

<script>
  import { parseExif, type ExifEntry } from '../lib/exif';

  // ---------- 상태 ----------

  type Layer = {
    id: number;
    name: string;
    canvas: HTMLCanvasElement;
    x: number;
    y: number;
    /** 캔버스에 그려지는 표시 크기. 원본 픽셀(canvas)은 그대로 두는 비파괴 스케일 */
    w: number;
    h: number;
    visible: boolean;
    exif: ExifEntry[] | null;
    isJpeg: boolean;
    thumb: string;
    /** 텍스트 레이어의 원본 속성 (수정 시 재베이크에 사용) */
    text?: { content: string; size: number; color: string };
  };

  let layers: Layer[] = []; // index 0 = 맨 아래
  let activeLayerId: number | null = null;
  let layerCounter = 0;
  let docWidth = 0;
  let docHeight = 0;
  let tool: 'move' | 'crop' | 'text' = 'move';

  const activeLayer = () => layers.find((l) => l.id === activeLayerId) ?? null;

  // ---------- 요소 ----------

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const docStack = el<HTMLDivElement>('doc-stack');
  const docCanvas = el<HTMLCanvasElement>('doc-canvas');
  const overlay = el<HTMLCanvasElement>('doc-overlay');
  const canvasArea = el<HTMLDivElement>('canvas-area');
  const dropGuide = el<HTMLParagraphElement>('drop-guide');
  const layerList = el<HTMLDivElement>('layer-list');
  const layerFileInput = el<HTMLInputElement>('layer-file');
  const contextHint = el<HTMLSpanElement>('context-hint');
  const cropOptions = el<HTMLDivElement>('crop-options');
  const cropApplyButton = el<HTMLButtonElement>('crop-apply');
  const docWidthInput = el<HTMLInputElement>('doc-width');
  const docHeightInput = el<HTMLInputElement>('doc-height');
  const docRatioLock = el<HTMLInputElement>('doc-ratio');
  const exportQuality = el<HTMLInputElement>('export-quality');
  const exifCard = el<HTMLDivElement>('exif-card');
  const statusDoc = el<HTMLSpanElement>('status-doc');
  const statusLayer = el<HTMLSpanElement>('status-layer');
  const statusMessage = el<HTMLSpanElement>('status-message');

  const docContext = docCanvas.getContext('2d')!;
  const overlayContext = overlay.getContext('2d')!;

  const setStatus = (message: string) => {
    statusMessage.textContent = message;
  };

  // ---------- 히스토리 (undo/redo) ----------
  // 레이어 픽셀(canvas)은 편집 시 새 객체로 교체될 뿐 변형되지 않으므로,
  // 스냅숏은 레이어 객체만 복제하고 canvas는 참조를 공유한다 (저비용).

  type Snapshot = {
    docWidth: number;
    docHeight: number;
    activeLayerId: number | null;
    layers: Layer[];
  };

  const HISTORY_LIMIT = 30;
  const undoStack: Snapshot[] = [];
  const redoStack: Snapshot[] = [];
  const undoButton = el<HTMLButtonElement>('history-undo');
  const redoButton = el<HTMLButtonElement>('history-redo');

  const snapshot = (): Snapshot => ({
    docWidth,
    docHeight,
    activeLayerId,
    layers: layers.map((layer) => ({ ...layer })),
  });

  function updateHistoryButtons() {
    undoButton.disabled = undoStack.length === 0;
    redoButton.disabled = redoStack.length === 0;
  }

  // 상태를 바꾸기 "직전"에 호출한다
  function pushHistory() {
    undoStack.push(snapshot());
    if (undoStack.length > HISTORY_LIMIT) undoStack.shift();
    redoStack.length = 0;
    updateHistoryButtons();
  }

  function restoreSnapshot(target: Snapshot) {
    docWidth = target.docWidth;
    docHeight = target.docHeight;
    activeLayerId = target.activeLayerId;
    layers = target.layers.map((layer) => ({ ...layer }));
    clearCropSelection();
    renderLayerList();
    renderExifPanel();
    renderDocument();
  }

  function undo() {
    const previous = undoStack.pop();
    if (!previous) return;
    redoStack.push(snapshot());
    restoreSnapshot(previous);
    updateHistoryButtons();
  }

  function redo() {
    const next = redoStack.pop();
    if (!next) return;
    undoStack.push(snapshot());
    restoreSnapshot(next);
    updateHistoryButtons();
  }

  undoButton.addEventListener('click', undo);
  redoButton.addEventListener('click', redo);

  // ---------- 합성 렌더 ----------

  function renderDocument() {
    if (layers.length === 0) {
      docStack.hidden = true;
      dropGuide.hidden = false;
      statusDoc.textContent = '캔버스 없음';
      statusLayer.textContent = '';
      return;
    }
    docCanvas.width = docWidth;
    docCanvas.height = docHeight;
    overlay.width = docWidth;
    overlay.height = docHeight;
    docContext.clearRect(0, 0, docWidth, docHeight);
    docContext.imageSmoothingQuality = 'high';
    for (const layer of layers) {
      if (layer.visible) docContext.drawImage(layer.canvas, layer.x, layer.y, layer.w, layer.h);
    }
    docStack.hidden = false;
    dropGuide.hidden = true;
    docWidthInput.value = String(docWidth);
    docHeightInput.value = String(docHeight);
    statusDoc.textContent = `캔버스 ${docWidth}×${docHeight}px · 레이어 ${layers.length}개`;
    statusLayer.textContent = activeLayer() ? `활성: ${activeLayer()!.name}` : '';
    drawSelection();
  }

  // ---------- 레이어 패널 ----------

  function makeThumb(canvas: HTMLCanvasElement): string {
    const thumb = document.createElement('canvas');
    const scale = 44 / Math.max(canvas.width, canvas.height);
    thumb.width = Math.max(1, Math.round(canvas.width * scale));
    thumb.height = Math.max(1, Math.round(canvas.height * scale));
    thumb.getContext('2d')!.drawImage(canvas, 0, 0, thumb.width, thumb.height);
    return thumb.toDataURL();
  }

  function renderLayerList() {
    layerList.innerHTML = '';
    // 목록은 위 = 최상위 레이어
    for (const layer of [...layers].reverse()) {
      const item = document.createElement('div');
      item.className = `layer-item${layer.id === activeLayerId ? ' active' : ''}`;
      item.addEventListener('click', () => {
        activeLayerId = layer.id;
        renderLayerList();
        renderExifPanel();
        renderDocument();
        syncTextOptions();
      });

      const eye = document.createElement('button');
      eye.type = 'button';
      eye.className = 'layer-eye';
      eye.textContent = layer.visible ? '👁' : '–';
      eye.title = layer.visible ? '숨기기' : '표시';
      eye.addEventListener('click', (e) => {
        e.stopPropagation();
        pushHistory();
        layer.visible = !layer.visible;
        renderLayerList();
        renderDocument();
      });

      const thumb = document.createElement('img');
      thumb.className = 'layer-thumb';
      thumb.src = layer.thumb;
      thumb.alt = '';

      const name = document.createElement('span');
      name.className = 'layer-name';
      name.textContent = layer.name;

      item.append(eye, thumb, name);
      layerList.appendChild(item);
    }
  }

  function renderExifPanel() {
    const layer = activeLayer();
    exifCard.innerHTML = '';
    if (!layer) {
      exifCard.textContent = '레이어를 선택하세요.';
      return;
    }
    if (layer.text) {
      exifCard.textContent = '텍스트 레이어입니다.';
      return;
    }
    if (!layer.isJpeg) {
      exifCard.textContent = 'EXIF는 주로 JPEG에 저장됩니다. 이 레이어는 확인을 지원하지 않습니다.';
      return;
    }
    if (!layer.exif || layer.exif.length === 0) {
      exifCard.textContent = 'EXIF 메타데이터가 없습니다.';
      return;
    }
    for (const entry of layer.exif) {
      const row = document.createElement('div');
      row.className = `exif-row${entry.sensitive ? ' exif-sensitive' : ''}`;
      const label = document.createElement('span');
      label.className = 'exif-label';
      label.textContent = entry.sensitive ? `⚠ ${entry.label}` : entry.label;
      const value = document.createElement('span');
      value.textContent = entry.value;
      row.append(label, value);
      exifCard.appendChild(row);
    }
  }

  // ---------- 레이어 추가 (파일 → 레이어) ----------

  async function addLayerFromFile(file: File) {
    setStatus('');
    if (!file.type.startsWith('image/')) {
      setStatus('이미지 파일이 아닙니다.');
      return;
    }
    let bitmap: ImageBitmap;
    try {
      bitmap = await createImageBitmap(file);
    } catch {
      setStatus(`${file.name}: 이미지를 불러오지 못했습니다.`);
      return;
    }
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    canvas.getContext('2d')!.drawImage(bitmap, 0, 0);
    bitmap.close();

    pushHistory();
    const isJpeg = file.type === 'image/jpeg';
    const layer: Layer = {
      id: layerCounter++,
      name: file.name,
      canvas,
      x: 0,
      y: 0,
      w: canvas.width,
      h: canvas.height,
      visible: true,
      exif: isJpeg ? parseExif(await file.arrayBuffer()) : null,
      isJpeg,
      thumb: makeThumb(canvas),
    };

    if (layers.length === 0) {
      // 첫 이미지가 캔버스 크기를 정의한다
      docWidth = canvas.width;
      docHeight = canvas.height;
    } else {
      // 이후 레이어는 캔버스 중앙에 배치
      layer.x = Math.round((docWidth - layer.w) / 2);
      layer.y = Math.round((docHeight - layer.h) / 2);
    }
    layers.push(layer);
    activeLayerId = layer.id;
    renderLayerList();
    renderExifPanel();
    renderDocument();
  }

  el<HTMLButtonElement>('layer-add').addEventListener('click', () => layerFileInput.click());

  layerFileInput.addEventListener('change', async () => {
    for (const file of Array.from(layerFileInput.files ?? [])) {
      await addLayerFromFile(file);
    }
    layerFileInput.value = '';
  });

  canvasArea.addEventListener('dragover', (e) => {
    e.preventDefault();
    canvasArea.classList.add('drag-over');
  });
  canvasArea.addEventListener('dragleave', () => canvasArea.classList.remove('drag-over'));
  canvasArea.addEventListener('drop', async (e) => {
    e.preventDefault();
    canvasArea.classList.remove('drag-over');
    for (const file of Array.from(e.dataTransfer?.files ?? [])) {
      await addLayerFromFile(file);
    }
  });

  document.addEventListener('paste', (e) => {
    const item = Array.from(e.clipboardData?.items ?? []).find((i) =>
      i.type.startsWith('image/'),
    );
    const file = item?.getAsFile();
    if (file) addLayerFromFile(file);
  });

  // ---------- 레이어 순서/삭제 ----------

  function moveActiveLayer(direction: 1 | -1) {
    const index = layers.findIndex((l) => l.id === activeLayerId);
    const next = index + direction;
    if (index < 0 || next < 0 || next >= layers.length) return;
    pushHistory();
    [layers[index], layers[next]] = [layers[next], layers[index]];
    renderLayerList();
    renderDocument();
  }

  el<HTMLButtonElement>('layer-up').addEventListener('click', () => moveActiveLayer(1));
  el<HTMLButtonElement>('layer-down').addEventListener('click', () => moveActiveLayer(-1));

  el<HTMLButtonElement>('layer-delete').addEventListener('click', () => {
    const index = layers.findIndex((l) => l.id === activeLayerId);
    if (index < 0) return;
    pushHistory();
    layers.splice(index, 1);
    activeLayerId = layers[Math.min(index, layers.length - 1)]?.id ?? null;
    if (layers.length === 0) {
      docWidth = 0;
      docHeight = 0;
      clearCropSelection();
    }
    renderLayerList();
    renderExifPanel();
    renderDocument();
  });

  // ---------- 도구 전환 ----------

  const toolButtons = {
    move: el<HTMLButtonElement>('tool-move'),
    crop: el<HTMLButtonElement>('tool-crop'),
    text: el<HTMLButtonElement>('tool-text'),
  };
  const textOptions = el<HTMLDivElement>('text-options');

  const TOOL_HINTS: Record<typeof tool, string> = {
    move: '이동 도구: 드래그로 활성 레이어 이동 · 모서리 핸들로 크기 조정',
    crop: '자르기 도구: 드래그로 영역 선택 · 안쪽 드래그 이동 · 핸들로 조정',
    text: '텍스트 도구: 내용을 입력한 뒤 캔버스를 클릭하면 그 위치에 텍스트 레이어가 추가됩니다.',
  };

  function setTool(next: typeof tool) {
    tool = next;
    for (const [name, button] of Object.entries(toolButtons)) {
      button.classList.toggle('active', name === next);
    }
    cropOptions.hidden = next !== 'crop';
    textOptions.hidden = next !== 'text';
    contextHint.textContent = TOOL_HINTS[next];
    if (next !== 'crop') {
      clearCropSelection();
    }
    if (next === 'text') syncTextOptions();
    drawSelection();
  }

  toolButtons.move.addEventListener('click', () => setTool('move'));
  toolButtons.crop.addEventListener('click', () => setTool('crop'));
  toolButtons.text.addEventListener('click', () => setTool('text'));

  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if ((e.metaKey || e.ctrlKey) && (e.key === 'z' || e.key === 'Z')) {
      e.preventDefault();
      if (e.shiftKey) redo();
      else undo();
      return;
    }
    if ((e.metaKey || e.ctrlKey) && (e.key === 'y' || e.key === 'Y')) {
      e.preventDefault();
      redo();
      return;
    }
    if (e.key === 'Escape' && tool === 'crop') {
      clearCropSelection();
      return;
    }
    if (e.key === 'v' || e.key === 'V') setTool('move');
    if (e.key === 'c' || e.key === 'C') setTool('crop');
    if (e.key === 't' || e.key === 'T') setTool('text');
  });

  // ---------- 텍스트 레이어 ----------

  const textContent = el<HTMLInputElement>('text-content');
  const textSize = el<HTMLInputElement>('text-size');
  const textColor = el<HTMLInputElement>('text-color');
  const textUpdateButton = el<HTMLButtonElement>('text-update');

  const TEXT_FONT_STACK = "'Pretendard Variable', Pretendard, 'Malgun Gothic', sans-serif";

  // 텍스트를 투명 배경 캔버스에 렌더링한다 (레이어의 원본 픽셀이 됨)
  function bakeTextCanvas(content: string, size: number, color: string): HTMLCanvasElement {
    const lines = content.split('\n');
    const font = `700 ${size}px ${TEXT_FONT_STACK}`;
    const measure = document.createElement('canvas').getContext('2d')!;
    measure.font = font;
    const pad = Math.ceil(size * 0.15);
    const lineHeight = Math.round(size * 1.3);
    const width = Math.ceil(Math.max(...lines.map((line) => measure.measureText(line).width)));

    const canvas = document.createElement('canvas');
    canvas.width = Math.max(1, width + pad * 2);
    canvas.height = Math.max(1, lineHeight * lines.length + pad * 2);
    const ctx = canvas.getContext('2d')!;
    ctx.font = font;
    ctx.fillStyle = color;
    ctx.textBaseline = 'top';
    lines.forEach((line, i) => ctx.fillText(line, pad, pad + i * lineHeight));
    return canvas;
  }

  const textLayerName = (content: string) =>
    `텍스트: ${content.length > 12 ? `${content.slice(0, 12)}…` : content}`;

  function currentTextValues() {
    return {
      content: textContent.value,
      size: Math.min(512, Math.max(8, Math.floor(Number(textSize.value) || 48))),
      color: textColor.value,
    };
  }

  function addTextLayer(point: { x: number; y: number }) {
    const values = currentTextValues();
    if (values.content.trim() === '') {
      setStatus('삽입할 텍스트를 먼저 입력하세요.');
      textContent.focus();
      return;
    }
    pushHistory();
    const canvas = bakeTextCanvas(values.content, values.size, values.color);
    const layer: Layer = {
      id: layerCounter++,
      name: textLayerName(values.content),
      canvas,
      x: Math.round(point.x - canvas.width / 2),
      y: Math.round(point.y - canvas.height / 2),
      w: canvas.width,
      h: canvas.height,
      visible: true,
      exif: null,
      isJpeg: false,
      thumb: makeThumb(canvas),
      text: values,
    };
    layers.push(layer);
    activeLayerId = layer.id;
    renderLayerList();
    renderExifPanel();
    renderDocument();
    syncTextOptions();
    setStatus('텍스트 레이어를 추가했습니다. 이동 도구(V)로 위치·크기를 조정할 수 있습니다.');
  }

  // 활성 레이어가 텍스트 레이어면 옵션 값을 채우고 수정 버튼을 활성화한다
  function syncTextOptions() {
    const layer = activeLayer();
    const isText = Boolean(layer?.text);
    textUpdateButton.disabled = !isText;
    if (layer?.text) {
      textContent.value = layer.text.content;
      textSize.value = String(layer.text.size);
      textColor.value = layer.text.color;
    }
  }

  textUpdateButton.addEventListener('click', () => {
    const layer = activeLayer();
    if (!layer?.text) return;
    const values = currentTextValues();
    if (values.content.trim() === '') {
      setStatus('텍스트 내용이 비어 있습니다.');
      return;
    }
    pushHistory();
    const canvas = bakeTextCanvas(values.content, values.size, values.color);
    // 기존 표시 스케일 비율을 유지한 채 내용만 교체
    const scaleFactor = layer.w / layer.canvas.width;
    layer.canvas = canvas;
    layer.w = canvas.width * scaleFactor;
    layer.h = canvas.height * scaleFactor;
    layer.text = values;
    layer.name = textLayerName(values.content);
    layer.thumb = makeThumb(canvas);
    renderLayerList();
    renderDocument();
    setStatus('텍스트 레이어를 수정했습니다.');
  });

  // ---------- 캔버스 좌표 (문서 픽셀 기준) ----------

  const docPoint = (e: PointerEvent) => {
    const rect = overlay.getBoundingClientRect();
    return {
      x: Math.min(docWidth, Math.max(0, ((e.clientX - rect.left) / rect.width) * docWidth)),
      y: Math.min(docHeight, Math.max(0, ((e.clientY - rect.top) / rect.height) * docHeight)),
    };
  };

  // 표시 배율 (문서 px → 화면 px). 핸들·선 두께를 화면 기준으로 일정하게 유지
  const displayScale = () => {
    const rect = overlay.getBoundingClientRect();
    return rect.width > 0 ? rect.width / docWidth : 1;
  };

  // ---------- 자르기 선택 (GIMP 스타일, 문서 좌표) ----------

  let selection: { x: number; y: number; w: number; h: number } | null = null;
  type DragMode = 'create' | 'move-sel' | 'edge' | 'move-layer' | 'scale-layer' | null;
  let dragMode: DragMode = null;
  let scaleCorner = 'se';
  let layerRectOrigin = { x: 0, y: 0, w: 0, h: 0 };
  let dragStart: { x: number; y: number } | null = null;
  let grabOffset = { x: 0, y: 0 };
  let activeEdge: 'n' | 's' | 'e' | 'w' | null = null;
  let layerOrigin = { x: 0, y: 0 };
  let movePushed = false;

  const cropRatio = (): number | null => {
    const value = (
      document.querySelector('input[name="crop-ratio"]:checked') as HTMLInputElement
    ).value;
    return value === 'free' ? null : Number(value);
  };

  const cropCancelButton = el<HTMLButtonElement>('crop-cancel');

  function clearCropSelection() {
    selection = null;
    cropApplyButton.disabled = true;
    cropCancelButton.disabled = true;
    drawSelection();
  }

  cropCancelButton.addEventListener('click', clearCropSelection);

  const handleLength = () => {
    if (!selection) return 18;
    const css = 18 / displayScale();
    return Math.max(6 / displayScale(), Math.min(css, selection.w / 3, selection.h / 3));
  };

  // 이동 도구에서 활성 레이어 외곽선 + 모서리 스케일 핸들을 그린다
  const layerCorners = (layer: Layer): [string, number, number][] => [
    ['nw', layer.x, layer.y],
    ['ne', layer.x + layer.w, layer.y],
    ['sw', layer.x, layer.y + layer.h],
    ['se', layer.x + layer.w, layer.y + layer.h],
  ];

  function layerCornerAt(point: { x: number; y: number }, layer: Layer): string | null {
    const radius = 12 / displayScale();
    for (const [zone, cx, cy] of layerCorners(layer)) {
      if (Math.abs(point.x - cx) <= radius && Math.abs(point.y - cy) <= radius) return zone;
    }
    return null;
  }

  function drawLayerHandles() {
    const layer = activeLayer();
    if (!layer) return;
    const scale = displayScale();
    overlayContext.strokeStyle = '#6c8cff';
    overlayContext.lineWidth = 1.5 / scale;
    overlayContext.setLineDash([6 / scale, 4 / scale]);
    overlayContext.strokeRect(layer.x, layer.y, layer.w, layer.h);
    overlayContext.setLineDash([]);
    const size = 10 / scale;
    for (const [, cx, cy] of layerCorners(layer)) {
      overlayContext.fillStyle = '#ffffff';
      overlayContext.fillRect(cx - size / 2, cy - size / 2, size, size);
      overlayContext.strokeRect(cx - size / 2, cy - size / 2, size, size);
    }
  }

  function drawSelection() {
    overlayContext.clearRect(0, 0, overlay.width, overlay.height);
    if (tool === 'move') {
      if (layers.length > 0) drawLayerHandles();
      return;
    }
    if (!selection) return;
    const scale = displayScale();
    const { x, y, w, h } = selection;
    overlayContext.fillStyle = 'rgba(0, 0, 0, 0.5)';
    overlayContext.fillRect(0, 0, overlay.width, overlay.height);
    overlayContext.clearRect(x, y, w, h);
    overlayContext.strokeStyle = '#6c8cff';
    overlayContext.lineWidth = 2 / scale;
    overlayContext.strokeRect(x, y, w, h);

    const L = handleLength();
    const T = 4 / scale;
    overlayContext.fillStyle = '#ffffff';
    overlayContext.fillRect(x, y, L, T);
    overlayContext.fillRect(x, y, T, L);
    overlayContext.fillRect(x + w - L, y, L, T);
    overlayContext.fillRect(x + w - T, y, T, L);
    overlayContext.fillRect(x, y + h - T, L, T);
    overlayContext.fillRect(x, y + h - L, T, L);
    overlayContext.fillRect(x + w - L, y + h - T, L, T);
    overlayContext.fillRect(x + w - T, y + h - L, T, L);
    if (cropRatio() === null) {
      const bar = Math.max(12 / scale, Math.min(24 / scale, w / 3, h / 3));
      overlayContext.fillRect(x + w / 2 - bar / 2, y, bar, T);
      overlayContext.fillRect(x + w / 2 - bar / 2, y + h - T, bar, T);
      overlayContext.fillRect(x, y + h / 2 - bar / 2, T, bar);
      overlayContext.fillRect(x + w - T, y + h / 2 - bar / 2, T, bar);
    }
  }

  function hitZone(point: { x: number; y: number }): string {
    if (!selection) return 'create';
    const { x, y, w, h } = selection;
    const tolerance = 4 / displayScale();
    if (
      point.x < x - tolerance ||
      point.x > x + w + tolerance ||
      point.y < y - tolerance ||
      point.y > y + h + tolerance
    ) {
      return 'create';
    }
    const cornerZone = handleLength() + 6 / displayScale();
    const nearLeft = point.x <= x + cornerZone;
    const nearRight = point.x >= x + w - cornerZone;
    const nearTop = point.y <= y + cornerZone;
    const nearBottom = point.y >= y + h - cornerZone;
    if (nearTop && nearLeft) return 'nw';
    if (nearTop && nearRight) return 'ne';
    if (nearBottom && nearLeft) return 'sw';
    if (nearBottom && nearRight) return 'se';
    if (cropRatio() === null) {
      const edgeZone = 12 / displayScale();
      if (point.y <= y + edgeZone) return 'n';
      if (point.y >= y + h - edgeZone) return 's';
      if (point.x <= x + edgeZone) return 'w';
      if (point.x >= x + w - edgeZone) return 'e';
    }
    return 'move-sel';
  }

  const ZONE_CURSORS: Record<string, string> = {
    nw: 'nwse-resize',
    se: 'nwse-resize',
    ne: 'nesw-resize',
    sw: 'nesw-resize',
    n: 'ns-resize',
    s: 'ns-resize',
    e: 'ew-resize',
    w: 'ew-resize',
    'move-sel': 'move',
    create: 'crosshair',
  };

  function oppositeCorner(zone: string): { x: number; y: number } {
    const { x, y, w, h } = selection!;
    if (zone === 'nw') return { x: x + w, y: y + h };
    if (zone === 'ne') return { x, y: y + h };
    if (zone === 'sw') return { x: x + w, y };
    return { x, y };
  }

  function sourceRect() {
    if (!selection || selection.w < 2 || selection.h < 2) return null;
    const sx = Math.min(docWidth - 1, Math.max(0, Math.round(selection.x)));
    const sy = Math.min(docHeight - 1, Math.max(0, Math.round(selection.y)));
    return {
      sx,
      sy,
      sw: Math.max(1, Math.min(Math.round(selection.w), docWidth - sx)),
      sh: Math.max(1, Math.min(Math.round(selection.h), docHeight - sy)),
    };
  }

  function updateCropStatus() {
    const rect = sourceRect();
    if (rect) setStatus(`선택 영역: ${rect.sw}×${rect.sh}px`);
  }

  // ---------- 캔버스 포인터 (이동/자르기 공용) ----------

  overlay.addEventListener('pointerdown', (e) => {
    if (layers.length === 0) return;
    e.preventDefault();
    overlay.setPointerCapture(e.pointerId);
    const point = docPoint(e);

    if (tool === 'text') {
      addTextLayer(point);
      return;
    }

    if (tool === 'move') {
      const layer = activeLayer();
      if (!layer) return;
      const corner = layerCornerAt(point, layer);
      if (corner) {
        dragMode = 'scale-layer';
        scaleCorner = corner;
        layerRectOrigin = { x: layer.x, y: layer.y, w: layer.w, h: layer.h };
      } else {
        dragMode = 'move-layer';
        dragStart = point;
        layerOrigin = { x: layer.x, y: layer.y };
      }
      movePushed = false;
      return;
    }

    const zone = hitZone(point);
    if (zone === 'move-sel' && selection) {
      dragMode = 'move-sel';
      grabOffset = { x: point.x - selection.x, y: point.y - selection.y };
    } else if (['nw', 'ne', 'sw', 'se'].includes(zone) && selection) {
      dragMode = 'create';
      dragStart = oppositeCorner(zone);
    } else if (['n', 's', 'e', 'w'].includes(zone) && selection) {
      dragMode = 'edge';
      activeEdge = zone as typeof activeEdge;
    } else {
      dragMode = 'create';
      dragStart = point;
      selection = null;
      cropApplyButton.disabled = true;
      drawSelection();
    }
  });

  overlay.addEventListener('pointermove', (e) => {
    if (layers.length === 0) return;
    const point = docPoint(e);

    if (dragMode === null) {
      if (tool === 'move') {
        const layer = activeLayer();
        const corner = layer ? layerCornerAt(point, layer) : null;
        overlay.style.cursor = corner ? ZONE_CURSORS[corner] : 'grab';
      } else if (tool === 'text') {
        overlay.style.cursor = 'text';
      } else {
        overlay.style.cursor = ZONE_CURSORS[hitZone(point)];
      }
      return;
    }

    if (dragMode === 'scale-layer') {
      const layer = activeLayer();
      if (!layer) return;
      if (!movePushed) {
        pushHistory();
        movePushed = true;
      }
      const origin = layerRectOrigin;
      // 반대 모서리를 고정점으로 비율을 유지하며 스케일
      const anchor = {
        x: scaleCorner.includes('w') ? origin.x + origin.w : origin.x,
        y: scaleCorner.includes('n') ? origin.y + origin.h : origin.y,
      };
      const factor = Math.max(
        Math.abs(point.x - anchor.x) / origin.w,
        Math.abs(point.y - anchor.y) / origin.h,
        8 / Math.max(origin.w, origin.h),
      );
      layer.w = origin.w * factor;
      layer.h = origin.h * factor;
      layer.x = scaleCorner.includes('w') ? anchor.x - layer.w : anchor.x;
      layer.y = scaleCorner.includes('n') ? anchor.y - layer.h : anchor.y;
      renderDocument();
      setStatus(`레이어 크기: ${Math.round(layer.w)}×${Math.round(layer.h)}px`);
      return;
    }

    if (dragMode === 'move-layer' && dragStart) {
      const layer = activeLayer();
      if (!layer) return;
      // 실제로 움직이기 시작한 시점에 한 번만 히스토리에 기록
      if (!movePushed) {
        pushHistory();
        movePushed = true;
      }
      layer.x = Math.round(layerOrigin.x + point.x - dragStart.x);
      layer.y = Math.round(layerOrigin.y + point.y - dragStart.y);
      renderDocument();
      return;
    }

    if (dragMode === 'move-sel' && selection) {
      selection.x = Math.min(docWidth - selection.w, Math.max(0, point.x - grabOffset.x));
      selection.y = Math.min(docHeight - selection.h, Math.max(0, point.y - grabOffset.y));
      drawSelection();
      updateCropStatus();
      return;
    }

    if (dragMode === 'edge' && selection && activeEdge) {
      const right = selection.x + selection.w;
      const bottom = selection.y + selection.h;
      if (activeEdge === 'e') {
        selection.w = Math.min(docWidth - selection.x, Math.max(2, point.x - selection.x));
      } else if (activeEdge === 'w') {
        selection.x = Math.min(right - 2, Math.max(0, point.x));
        selection.w = right - selection.x;
      } else if (activeEdge === 's') {
        selection.h = Math.min(docHeight - selection.y, Math.max(2, point.y - selection.y));
      } else {
        selection.y = Math.min(bottom - 2, Math.max(0, point.y));
        selection.h = bottom - selection.y;
      }
      drawSelection();
      updateCropStatus();
      return;
    }

    if (dragMode !== 'create' || !dragStart) return;
    let dx = point.x - dragStart.x;
    let dy = point.y - dragStart.y;
    const ratio = cropRatio();
    if (ratio !== null) {
      const signX = dx >= 0 ? 1 : -1;
      const signY = dy >= 0 ? 1 : -1;
      const maxW = signX > 0 ? docWidth - dragStart.x : dragStart.x;
      const maxH = signY > 0 ? docHeight - dragStart.y : dragStart.y;
      const width = Math.min(Math.abs(dx), maxW, maxH * ratio);
      dx = signX * width;
      dy = signY * (width / ratio);
    }
    selection = {
      x: Math.min(dragStart.x, dragStart.x + dx),
      y: Math.min(dragStart.y, dragStart.y + dy),
      w: Math.abs(dx),
      h: Math.abs(dy),
    };
    drawSelection();
    updateCropStatus();
  });

  overlay.addEventListener('pointerup', () => {
    if (dragMode === 'move-layer') setStatus('');
    dragMode = null;
    dragStart = null;
    activeEdge = null;
    const hasSelection = tool === 'crop' && sourceRect() !== null;
    cropApplyButton.disabled = !hasSelection;
    cropCancelButton.disabled = !hasSelection;
  });

  // ---------- 자르기 적용: 문서를 줄이고 레이어 오프셋을 이동 ----------

  cropApplyButton.addEventListener('click', () => {
    const rect = sourceRect();
    if (!rect) return;
    pushHistory();
    docWidth = rect.sw;
    docHeight = rect.sh;
    for (const layer of layers) {
      layer.x -= rect.sx;
      layer.y -= rect.sy;
    }
    clearCropSelection();
    renderDocument();
    setStatus(`캔버스를 ${rect.sw}×${rect.sh}px로 잘랐습니다. (레이어 픽셀은 보존됨)`);
  });

  // ---------- 문서 리사이즈 (전체 스케일) ----------

  docWidthInput.addEventListener('input', () => {
    if (!docRatioLock.checked || docWidth === 0) return;
    const width = Number(docWidthInput.value);
    if (width > 0) {
      docHeightInput.value = String(Math.max(1, Math.round((width / docWidth) * docHeight)));
    }
  });

  docHeightInput.addEventListener('input', () => {
    if (!docRatioLock.checked || docHeight === 0) return;
    const height = Number(docHeightInput.value);
    if (height > 0) {
      docWidthInput.value = String(Math.max(1, Math.round((height / docHeight) * docWidth)));
    }
  });

  el<HTMLButtonElement>('doc-resize').addEventListener('click', () => {
    if (layers.length === 0) return;
    const width = Math.floor(Number(docWidthInput.value));
    const height = Math.floor(Number(docHeightInput.value));
    if (!(width >= 1 && height >= 1 && width <= 20000 && height <= 20000)) {
      setStatus('폭과 높이는 1~20000 사이여야 합니다.');
      return;
    }
    pushHistory();
    const fx = width / docWidth;
    const fy = height / docHeight;
    // 원본 픽셀은 그대로 두고 표시 크기·오프셋만 스케일 (비파괴)
    for (const layer of layers) {
      layer.x = Math.round(layer.x * fx);
      layer.y = Math.round(layer.y * fy);
      layer.w = Math.max(1, layer.w * fx);
      layer.h = Math.max(1, layer.h * fy);
    }
    docWidth = width;
    docHeight = height;
    clearCropSelection();
    renderLayerList();
    renderDocument();
    setStatus(`캔버스를 ${width}×${height}px로 리사이즈했습니다.`);
  });

  // ---------- 내보내기 (보이는 레이어 합성) ----------

  const EXTENSIONS: Record<string, string> = {
    'image/png': 'png',
    'image/jpeg': 'jpg',
    'image/webp': 'webp',
  };

  const exportFormat = () =>
    (document.querySelector('input[name="export-format"]:checked') as HTMLInputElement).value;

  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="export-format"]')) {
    radio.addEventListener('change', () => {
      exportQuality.disabled = exportFormat() === 'image/png';
    });
  }

  el<HTMLButtonElement>('export-download').addEventListener('click', () => {
    if (layers.length === 0) return;
    const format = exportFormat();
    const quality = Math.min(100, Math.max(1, Number(exportQuality.value) || 90)) / 100;
    // docCanvas가 이미 문서 해상도의 합성 결과다
    renderDocument();
    docCanvas.toBlob(
      (blob) => {
        if (!blob) {
          setStatus('변환에 실패했습니다. (이 브라우저가 해당 형식을 지원하지 않을 수 있음)');
          return;
        }
        const url = URL.createObjectURL(blob);
        const anchor = document.createElement('a');
        anchor.href = url;
        const base = (layers[0]?.name ?? 'image').replace(/\.[^.]+$/, '') || 'image';
        anchor.download = `${base}.${EXTENSIONS[format]}`;
        anchor.click();
        URL.revokeObjectURL(url);
        setStatus(`${anchor.download} (${(blob.size / 1024 / 1024).toFixed(2)}MB) 다운로드 — EXIF 제거됨`);
      },
      format,
      quality,
    );
  });

  setTool('move');
</script>

<style>
