    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.7rem 1.2rem;
    border-bottom: 1px solid var(--border);
    flex-wrap: wrap;
    /* 우상단 테마 토글과 겹치지 않게 여유 */
    padding-right: 5rem;
  }

  .editor-header .home {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .editor-header .home:hover {
    color: var(--accent);
  }

  .editor-header h1 {
    margin: 0;
    font-size: 1.15rem;
  }

  .editor-header .note {
    color: var(--text-dim);
    font-size: 0.8rem;
  }

  /* ---------- 에디터 그리드 ---------- */

  .editor {
    flex: 1;
    display: grid;
    grid-template-columns: 56px 1fr 280px;
    min-height: 0;
  }

  .toolbar {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0;
    border-right: 1px solid var(--border);
    background: var(--bg-soft);
  }

  .tool {
    width: 40px;
    height: 40px;
    display: grid;
