    border-radius: 0.55rem;
    cursor: pointer;
  }

  .tool:hover {
    border-color: var(--border);
    color: var(--text);
  }

  .tool.active {
    background: var(--accent);
    color: #fff;
  }

  .tool:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .toolbar-divider {
    width: 60%;
