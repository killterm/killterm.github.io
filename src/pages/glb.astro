---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="GLB 뷰어 — Killterm"
  description="GLB/GLTF 3D 모델을 브라우저에서 바로 확인합니다."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>🧊 GLB 뷰어</h1>
      <p>
        GLB/GLTF 3D 모델을 브라우저에서 바로 확인합니다. 파일은 브라우저 밖으로 전송되지
        않습니다. 애니메이션이 없는 모델에는 뷰어가 기본 클립(회전·둥실)을 자동으로
        생성해 제공합니다.
      </p>
    </header>

    <div class="toolbar">
      <button id="glb-select" class="btn btn-primary" type="button">GLB 파일 선택</button>
      <input id="glb-file" type="file" accept=".glb,.gltf" hidden />
      <div class="sample-row" aria-label="기본 모델">
        <span class="sample-label">기본 모델</span>
        <button
          class="btn btn-small sample"
          data-src="/models/RobotExpressive.glb"
          data-name="RobotExpressive.glb"
          type="button"
        >
          🤖 로봇
        </button>
        <button class="btn btn-small sample" data-src="/models/Fox.glb" data-name="Fox.glb" type="button">
          🦊 여우
        </button>
        <button
          class="btn btn-small sample"
          data-src="/models/Duck.gltf"
          data-name="Duck.gltf"
          type="button"
        >
          🦆 오리
        </button>
      </div>
      <div class="chip-group" aria-label="표시 옵션">
        <label class="chip">
          <input type="checkbox" id="glb-wireframe" />
          <span>와이어프레임</span>
        </label>
        <label class="chip">
          <input type="checkbox" id="glb-grid" checked />
          <span>그리드</span>
        </label>
        <label class="chip">
          <input type="checkbox" id="glb-rotate" />
          <span>자동 회전</span>
        </label>
      </div>
      <div class="anim-row">
        <select id="glb-anim" aria-label="애니메이션 클립 선택" disabled>
          <option>애니메이션 없음</option>
        </select>
        <button id="glb-anim-toggle" class="btn btn-small" type="button" disabled>▶ 재생</button>
      </div>
    </div>

    <div class="stage" id="glb-stage">
      <canvas id="glb-canvas"></canvas>
      <p class="placeholder" id="glb-placeholder">
        GLB/GLTF 파일을 여기에 드래그하거나 위의 버튼으로 선택하세요.<br />
        드래그: 회전 · 우클릭 드래그: 이동 · 휠: 확대/축소
      </p>
    </div>

    <p id="glb-info" class="hint"></p>
    <p class="hint">
      기본 모델 출처 — 여우: PixelMannen · @tomkranis (CC BY 4.0, Khronos glTF Sample
      Assets), 로봇: Tomás Laulhé (CC0, three.js examples), 오리: Sony (SCEA Shared
      Source License, Khronos glTF Sample Assets)
    </p>
    <p id="glb-status" class="status" role="status"></p>
  </main>
</Layout>

<script>
  import * as THREE from 'three';
  import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
  import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
  import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

  const stage = document.getElementById('glb-stage') as HTMLDivElement;
  const canvas = document.getElementById('glb-canvas') as HTMLCanvasElement;
  const fileInput = document.getElementById('glb-file') as HTMLInputElement;
  const wireframeCheckbox = document.getElementById('glb-wireframe') as HTMLInputElement;
  const gridCheckbox = document.getElementById('glb-grid') as HTMLInputElement;
  const rotateCheckbox = document.getElementById('glb-rotate') as HTMLInputElement;
  const animSelect = document.getElementById('glb-anim') as HTMLSelectElement;
  const animToggle = document.getElementById('glb-anim-toggle') as HTMLButtonElement;
  const info = document.getElementById('glb-info') as HTMLParagraphElement;
  const status = document.getElementById('glb-status') as HTMLParagraphElement;

  // ---------- 씬 구성 ----------

  const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(50, 1, 0.1, 1000);
  camera.position.set(3, 2, 4);

  const controls = new OrbitControls(camera, canvas);
  controls.enableDamping = true;

  scene.add(new THREE.HemisphereLight(0xffffff, 0x445566, 1.6));
  const directional = new THREE.DirectionalLight(0xffffff, 2.2);
  directional.position.set(5, 8, 6);
  scene.add(directional);

  // 배경색은 사이트 테마(--bg-soft)를 따라간다
  function syncBackground() {
    const color = getComputedStyle(document.documentElement).getPropertyValue('--bg-soft').trim();
    scene.background = new THREE.Color(color || '#171a23');
  }
  syncBackground();
  new MutationObserver(syncBackground).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.matchMedia('(prefers-color-scheme: light)').addEventListener('change', syncBackground);

  function resize() {
    const width = stage.clientWidth;
    const height = stage.clientHeight;
    renderer.setSize(width, height, false);
    camera.aspect = width / height;
    camera.updateProjectionMatrix();
  }
  new ResizeObserver(resize).observe(stage);
  resize();

  // ---------- 로더 ----------

  const dracoLoader = new DRACOLoader();
  dracoLoader.setDecoderPath('/draco/');
  const loader = new GLTFLoader();
  loader.setDRACOLoader(dracoLoader);

  let model: THREE.Group | null = null;
  let grid: THREE.GridHelper | null = null;
  let mixer: THREE.AnimationMixer | null = null;
  let actions: THREE.AnimationAction[] = [];
  let animPlaying = false;
  const clock = new THREE.Clock();

  function disposeModel() {
    if (model) {
      scene.remove(model);
      model.traverse((child) => {
        if (child instanceof THREE.Mesh) {
          child.geometry.dispose();
          const materials = Array.isArray(child.material) ? child.material : [child.material];
          for (const material of materials) material.dispose();
        }
      });
    }
    if (grid) {
      scene.remove(grid);
      grid.dispose();
    }
    model = null;
    grid = null;
    mixer = null;
    actions = [];
    animPlaying = false;
    animSelect.innerHTML = '<option>애니메이션 없음</option>';
    animSelect.disabled = true;
    animToggle.disabled = true;
    animToggle.textContent = '▶ 재생';
  }

  // Box3 바운딩으로 카메라·그리드를 모델 크기에 맞춘다
  function frameModel(target: THREE.Group) {
    const box = new THREE.Box3().setFromObject(target);
    const size = box.getSize(new THREE.Vector3());
    const center = box.getCenter(new THREE.Vector3());
    const maxDimension = Math.max(size.x, size.y, size.z) || 1;

    camera.near = maxDimension / 100;
    camera.far = maxDimension * 100;
    camera.position.set(
      center.x + maxDimension * 0.9,
      center.y + maxDimension * 0.6,
      center.z + maxDimension * 1.2,
    );
    camera.updateProjectionMatrix();
    controls.target.copy(center);
    controls.update();

    grid = new THREE.GridHelper(maxDimension * 3, 20, 0x888888, 0x444444);
    grid.position.y = box.min.y;
    grid.visible = gridCheckbox.checked;
    scene.add(grid);
  }

  function applyWireframe() {
    model?.traverse((child) => {
      if (child instanceof THREE.Mesh) {
        const materials = Array.isArray(child.material) ? child.material : [child.material];
        for (const material of materials) {
          if ('wireframe' in material) {
            (material as THREE.MeshStandardMaterial).wireframe = wireframeCheckbox.checked;
          }
        }
      }
    });
  }

  // 파일에 애니메이션이 없으면 뷰어가 KeyframeTrack으로 기본 클립을 직접 생성한다.
  // .glb든 .gltf든 로드 후에는 같은 씬 그래프라서 동일하게 동작한다.
  function createDefaultClips(target: THREE.Group): THREE.AnimationClip[] {
    target.name = 'ViewerRoot';
    const box = new THREE.Box3().setFromObject(target);
    const height = box.getSize(new THREE.Vector3()).y || 1;
    const baseY = target.position.y;
    const spin = new THREE.AnimationClip('회전 (뷰어 생성)', 6, [
      new THREE.NumberKeyframeTrack('ViewerRoot.rotation[y]', [0, 6], [0, Math.PI * 2]),
    ]);
    const bob = new THREE.AnimationClip('둥실 (뷰어 생성)', 2.4, [
      new THREE.NumberKeyframeTrack(
        'ViewerRoot.position[y]',
        [0, 1.2, 2.4],
        [baseY, baseY + height * 0.12, baseY],
      ),
    ]);
    return [spin, bob];
  }

  function setupAnimations(clips: THREE.AnimationClip[], target: THREE.Group) {
    const fromFile = clips.length > 0;
    const effectiveClips = fromFile ? clips : createDefaultClips(target);
    mixer = new THREE.AnimationMixer(target);
    actions = effectiveClips.map((clip) => mixer!.clipAction(clip));
    animSelect.innerHTML = '';
    for (const [i, clip] of effectiveClips.entries()) {
      const option = document.createElement('option');
      option.value = String(i);
      option.textContent = clip.name || `클립 ${i + 1}`;
      animSelect.appendChild(option);
    }
    animSelect.disabled = false;
    animToggle.disabled = false;
    playClip(0);
    // 뷰어가 만든 클립은 자동 재생하지 않는다 (정적 모델을 그대로 보려는 경우가 많으므로)
    if (!fromFile) {
      animPlaying = false;
      animToggle.textContent = '▶ 재생';
      for (const action of actions) action.paused = true;
    }
  }

  function playClip(index: number) {
    for (const action of actions) action.stop();
    actions[index]?.reset().play();
    animPlaying = true;
    animToggle.textContent = '⏸ 정지';
  }

  function describeModel(
    target: THREE.Group,
    clipCount: number,
    name: string,
    sizeBytes: number | null,
  ) {
    let meshes = 0;
    let vertices = 0;
    let triangles = 0;
    target.traverse((child) => {
      if (child instanceof THREE.Mesh) {
        meshes++;
        const position = child.geometry.attributes.position;
        if (position) vertices += position.count;
        const index = child.geometry.index;
        triangles += Math.floor((index ? index.count : position?.count ?? 0) / 3);
      }
    });
    const size = sizeBytes === null ? '' : ` (${(sizeBytes / 1024 / 1024).toFixed(2)}MB)`;
    const clips = clipCount === 0 ? '애니메이션 0개 (뷰어 생성 클립 제공)' : `애니메이션 ${clipCount}개`;
    info.textContent =
      `${name}${size} — 메시 ${meshes.toLocaleString()}개 · ` +
      `버텍스 ${vertices.toLocaleString()}개 · 삼각형 ${triangles.toLocaleString()}개 · ${clips}`;
  }

  function showModel(gltf: { scene: THREE.Group; animations: THREE.AnimationClip[] }, name: string, sizeBytes: number | null) {
    disposeModel();
    model = gltf.scene;
    scene.add(model);
    frameModel(model);
    applyWireframe();
    setupAnimations(gltf.animations, model);
    describeModel(model, gltf.animations.length, name, sizeBytes);
  }

  // 내장 기본 모델 등 URL에서 직접 로드 (.gltf의 외부 bin/텍스처는 같은 경로에서 해석됨)
  function loadFromUrl(url: string, name: string) {
    status.textContent = '';
    loader.load(
      url,
      (gltf) => showModel(gltf, name, null),
      undefined,
      (e) => {
        status.textContent = `모델을 불러오지 못했습니다. (${e instanceof Error ? e.message : String(e)})`;
      },
    );
  }

  function loadFile(file: File) {
    status.textContent = '';
    if (!/\.(glb|gltf)$/i.test(file.name)) {
      status.textContent = 'GLB 또는 GLTF 파일을 선택해주세요.';
      return;
    }
    const url = URL.createObjectURL(file);
    loader.load(
      url,
      (gltf) => {
        URL.revokeObjectURL(url);
        showModel(gltf, file.name, file.size);
      },
      undefined,
      (e) => {
        URL.revokeObjectURL(url);
        status.textContent =
          '모델을 불러오지 못했습니다. 외부 리소스(bin/텍스처)를 참조하는 .gltf는 ' +
          '단일 파일(GLB)로 변환한 뒤 사용해주세요. ' +
          `(${e instanceof Error ? e.message : String(e)})`;
      },
    );
  }

  // ---------- 입력 ----------

  document.getElementById('glb-select')!.addEventListener('click', () => fileInput.click());

  // 기본 모델: 사이트에 내장된 파일을 URL로 직접 로드
  for (const button of document.querySelectorAll<HTMLButtonElement>('.sample')) {
    button.addEventListener('click', () => {
      loadFromUrl(button.dataset.src!, button.dataset.name!);
    });
  }

  fileInput.addEventListener('change', () => {
    const file = fileInput.files?.[0];
    if (file) loadFile(file);
    fileInput.value = '';
  });

  stage.addEventListener('dragover', (e) => {
    e.preventDefault();
    stage.classList.add('drag-over');
  });
  stage.addEventListener('dragleave', () => stage.classList.remove('drag-over'));
  stage.addEventListener('drop', (e) => {
    e.preventDefault();
    stage.classList.remove('drag-over');
    const file = e.dataTransfer?.files?.[0];
    if (file) loadFile(file);
  });

  wireframeCheckbox.addEventListener('change', applyWireframe);
  gridCheckbox.addEventListener('change', () => {
    if (grid) grid.visible = gridCheckbox.checked;
  });
  rotateCheckbox.addEventListener('change', () => {
    controls.autoRotate = rotateCheckbox.checked;
  });

  animSelect.addEventListener('change', () => playClip(Number(animSelect.value)));
  animToggle.addEventListener('click', () => {
    animPlaying = !animPlaying;
    animToggle.textContent = animPlaying ? '⏸ 정지' : '▶ 재생';
    for (const action of actions) action.paused = !animPlaying;
  });

  // ---------- 렌더 루프 ----------

  renderer.setAnimationLoop(() => {
    const delta = clock.getDelta();
    if (mixer && animPlaying) mixer.update(delta);
    controls.update();
    renderer.render(scene, camera);
  });
</script>

<style>
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .intro p {
    color: var(--text-dim);
    margin: 0 0 1.5rem;
  }

  .toolbar {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .chip-group {
    display: inline-flex;
    gap: 4px;
    padding: 3px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0.7rem;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: block;
    padding: 0.3rem 0.7rem;
    border-radius: 0.5rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--text-dim);
    cursor: pointer;
    user-select: none;
  }

  .chip input:checked + span {
    background: var(--accent);
    color: #fff;
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--accent);
  }

  .sample-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .sample-label {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .anim-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* 애니메이션이 없는 모델일 때는 컨트롤을 음영 처리해 비활성 상태를 보여준다 */
  .anim-row select:disabled,
  .anim-row .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .anim-row select {
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.4rem 0.6rem;
    border-radius: 0.6rem;
    max-width: 220px;
  }

  .stage {
    position: relative;
    height: min(64vh, 640px);
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    overflow: hidden;
    background: var(--bg-soft);
  }

  .stage.drag-over {
    border-color: var(--accent);
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  .stage canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* 스테이지 하단의 안내 띠 (모델을 가리지 않도록) */
  .placeholder {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin: 0;
    padding: 0.5rem 1rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.82rem;
    background: light-dark(rgba(255, 255, 255, 0.7), rgba(15, 17, 23, 0.6));
    pointer-events: none;
  }

  .btn {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    padding: 0.55rem 1.2rem;
    border-radius: 0.7rem;
    cursor: pointer;
  }

  .btn:hover {
    border-color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-small {
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
  }

  .hint {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin: 0.8rem 0 0;
  }

  .status {
    min-height: 1.2em;
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    color: var(--danger);
    overflow-wrap: anywhere;
  }
</style>
