---
import Layout from '../layouts/Layout.astro';
import GlassSlider from '../components/GlassSlider.astro';
import { MAX_CHANNELS } from '../lib/composer-engine';
---

<Layout
  title="칩튠 작곡기 — Killterm"
  description="SFX 생성기의 소리를 악기로 써서 패턴 시퀀싱으로 곡을 만듭니다."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>🎹 칩튠 작곡기</h1>
      <p>
        <a href="/sfx/">레트로 SFX 생성기</a>에서 보관함에 저장한 소리를 악기로 골라,
        패턴에 노트를 찍고 순서를 이어붙여 곡을 만드세요. 채널은 최대 8개까지 늘릴 수 있고
        (스텝당 한 음), 작업 중인 곡은 이 브라우저에 자동 저장됩니다.
      </p>
    </header>

    <section class="toolbar">
      <button id="play-toggle" class="btn btn-primary" type="button">▶ 재생</button>
      <span class="mode-group" role="group" aria-label="재생 범위">
        <button id="mode-pattern" class="btn btn-small mode" aria-pressed="true" type="button">
          패턴
        </button>
        <button id="mode-song" class="btn btn-small mode" aria-pressed="false" type="button">
          곡 (시퀀스)
        </button>
      </span>
      <label class="num-field">
        BPM
        <input id="bpm-input" type="number" min="60" max="240" step="1" value="120" />
      </label>
      <span class="row-label">마스터</span>
      <GlassSlider id="master-volume" min="0" max="100" step="1" value="80" aria-label="마스터 볼륨" />
      <span class="mono-value" id="master-value">80%</span>
      <span class="master-meter">
        <canvas id="master-scope" width="220" height="52" aria-hidden="true"></canvas>
        <span class="clip-flag" id="clip-flag" hidden>클리핑</span>
      </span>
    </section>

    <div class="demo-row">
      <span class="row-label">예시 곡</span>
      <button
        class="btn demo-button"
        type="button"
        data-demo="/songs/demo.json"
        data-demo-name="밝은 행진 · C장조 4채널"
      >
        🎵 밝은 행진
      </button>
      <button
        class="btn demo-button"
        type="button"
        data-demo="/songs/demo2.json"
        data-demo-name="Am 아르페지오 · 7채널"
      >
        🎵 Am 아르페지오
      </button>
      <button
        class="btn demo-button"
        type="button"
        data-demo="/songs/demo3.json"
        data-demo-name="질주 · Em 168BPM 6채널"
      >
        🎵 질주
      </button>
      <span class="hint">AI 제작 · CC0 — 처음이라면 눌러서 전체 흐름을 확인해보세요.</span>
    </div>

    <section class="channels" aria-label="채널 믹서">
      {
        Array.from({ length: MAX_CHANNELS }, (_, channelIndex) => (
          <div class={`channel-row ch-${channelIndex}`} data-channel={channelIndex} hidden>
            <button
              class="channel-pick"
              type="button"
              data-pick={channelIndex}
              aria-pressed={channelIndex === 0 ? 'true' : 'false'}
            >
              {channelIndex + 1}
            </button>
            <select
              id={`instrument-select-${channelIndex}`}
              class="instrument"
              aria-label={`채널 ${channelIndex + 1} 악기`}
            />
            <GlassSlider
              id={`channel-volume-${channelIndex}`}
              min="0"
              max="100"
              step="1"
              value="80"
              aria-label={`채널 ${channelIndex + 1} 볼륨`}
            />
            <span class="mono-value" data-volume-for={channelIndex}>
              80%
            </span>
            <canvas
              class="scope"
              data-scope={channelIndex}
              width="180"
              height="52"
              aria-hidden="true"></canvas>
            <label class="check-field">
              <input type="checkbox" class="mute" data-mute={channelIndex} />
              음소거
            </label>
            <button class="btn btn-small" type="button" data-clear-channel={channelIndex}>
              비우기
            </button>
            <button
              class="btn btn-small danger"
              type="button"
              data-remove-channel={channelIndex}
              aria-label={`채널 ${channelIndex + 1} 제거`}
            >
              제거
            </button>
          </div>
        ))
      }
      <div class="field-row">
        <button id="channel-add" class="btn btn-small" type="button">＋ 채널 추가</button>
        <span class="hint" id="channel-count-hint"></span>
      </div>
    </section>

    <div class="roll" id="roll-scroll">
      <div class="roll-grid" id="roll-grid"></div>
    </div>

    <section class="patterns">
      <div class="field-row">
        <span class="row-label">패턴</span>
        <span id="pattern-list" class="chip-row"></span>
        <button id="pattern-add" class="btn btn-small" type="button">＋ 추가</button>
        <button id="pattern-clone" class="btn btn-small" type="button">⧉ 복제</button>
        <button id="pattern-delete" class="btn btn-small" type="button">× 삭제</button>
        <button id="pattern-clear" class="btn btn-small" type="button">이 패턴 비우기</button>
        <button id="song-clear" class="btn btn-small" type="button">전체 비우기</button>
      </div>
      <div class="field-row">
        <span class="row-label">시퀀스</span>
        <span id="sequence-list" class="chip-row"></span>
        <button id="sequence-add" class="btn btn-small" type="button">＋ 현재 패턴 추가</button>
      </div>
      <p class="hint">
        시퀀스는 곡의 구성입니다 — 패턴 번호를 순서대로 이어붙여 하나의 곡이 됩니다.
        "곡 (시퀀스)" 모드로 재생하면 이 순서대로 연주합니다.
      </p>
    </section>

    <section class="exports">
      <div class="field-row">
        <span class="row-label">내보내기</span>
        <button id="export-wav" class="btn btn-small" type="button">💾 WAV (곡 전체)</button>
        <button id="export-json" class="btn btn-small" type="button">곡 JSON 내보내기</button>
        <button id="import-json" class="btn btn-small" type="button">곡 JSON 가져오기</button>
        <button id="reset-song" class="btn btn-small" type="button">새 곡</button>
      </div>
      <input id="import-input" type="file" accept=".json,application/json" hidden />
    </section>

    <div class="status-row">
      <p id="status" class="status" role="status"></p>
      <button id="undo-action" class="btn btn-small" type="button" hidden>되돌리기</button>
    </div>
  </main>
</Layout>

<script>
  import {
    BUILTIN_INSTRUMENTS,
    MAX_CHANNELS,
    MAX_PATTERNS,
    MAX_SEQUENCE,
    NOTE_COUNT,
    PATTERN_STEPS,
    addChannel,
    cloneInstrument,
    defaultSong,
    removeChannel,
    restoreChannel,
    emptyPattern,
    isBlackKey,
    mixSong,
    normalizeSong,
    noteLabel,
    renderNote,
    stepDuration,
    type Song,
  } from '../lib/composer-engine';
  import { SAMPLE_RATE } from '../lib/sfx-synth';
  import { listSounds } from '../lib/sfx-store';
  import { encodeWav } from '../lib/wav-encode';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const playToggle = el<HTMLButtonElement>('play-toggle');
  const modePatternButton = el<HTMLButtonElement>('mode-pattern');
  const modeSongButton = el<HTMLButtonElement>('mode-song');
  const bpmInput = el<HTMLInputElement>('bpm-input');
  const masterVolumeSlider = el<HTMLInputElement>('master-volume');
  const masterValue = el<HTMLSpanElement>('master-value');
  const channelRows = [...document.querySelectorAll<HTMLDivElement>('.channel-row')];
  const pickButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-pick]')];
  const instrumentSelects = [...document.querySelectorAll<HTMLSelectElement>('.instrument')];
  // 믹서 행은 MAX_CHANNELS개가 미리 렌더되어 있으므로 참조도 그 수만큼 모은다
  // (4개로 하드코딩했다가 리스너를 걸 때 undefined로 초기화가 멈춘 적이 있다)
  const volumeSliders = Array.from({ length: MAX_CHANNELS }, (_, i) =>
    el<HTMLInputElement>(`channel-volume-${i}`),
  );
  const muteToggles = [...document.querySelectorAll<HTMLInputElement>('.mute')];
  const clearChannelButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-clear-channel]')];
  const removeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-remove-channel]')];
  const addChannelButton = el<HTMLButtonElement>('channel-add');
  const channelCountHint = el<HTMLSpanElement>('channel-count-hint');
  const rollGrid = el<HTMLDivElement>('roll-grid');
  const patternList = el<HTMLSpanElement>('pattern-list');
  const sequenceList = el<HTMLSpanElement>('sequence-list');
  const importInput = el<HTMLInputElement>('import-input');
  const status = el<HTMLParagraphElement>('status');

  const undoButton = el<HTMLButtonElement>('undo-action');

  const setStatus = (message: string) => {
    status.textContent = message;
  };

  // 브라우저가 반복된 네이티브 대화상자를 차단하면 confirm()이 항상 false를 돌려줘
  // 삭제가 조용히 무시된다. 그래서 지우는 동작은 곧바로 실행하고 되돌리기를 준다.
  let pendingUndo: { message: string; apply: () => void } | null = null;

  function offerUndo(message: string, apply: () => void) {
    pendingUndo = { message, apply };
    setStatus(message);
    undoButton.hidden = false;
  }

  function clearUndo() {
    pendingUndo = null;
    undoButton.hidden = true;
  }

  // ---------- 상태 ----------

  const SONG_STORAGE_KEY = 'killterm-composer-song';

  function loadSong(): Song {
    try {
      const raw = localStorage.getItem(SONG_STORAGE_KEY);
      if (raw) {
        const restored = normalizeSong(JSON.parse(raw));
        if (restored) return restored;
      }
    } catch {
      // 깨진 저장본은 새 곡으로 대체
    }
    return defaultSong();
  }

  let song = loadSong();
  let currentPatternIndex = 0;
  let currentChannelIndex = 0;
  let playMode: 'pattern' | 'song' = 'pattern';

  function persist() {
    localStorage.setItem(SONG_STORAGE_KEY, JSON.stringify(song));
  }

  const masterVolume = () => Number(masterVolumeSlider.value) / 100;

  // ---------- 재생 (룩어헤드 스케줄러) ----------
  // setInterval은 째깍임이 불안정하므로 시각은 항상 AudioContext 클록으로
  // 계산하고, 25ms마다 앞으로 0.12초어치 노트를 미리 예약한다.

  const SCHEDULE_AHEAD_SECONDS = 0.12;
  let audioContext: AudioContext | null = null;
  let playing = false;
  let timer = 0;
  let nextStepTime = 0;
  let globalStep = 0;
  const activeSources = new Set<AudioBufferSourceNode>();
  const stepQueue: { step: number; time: number }[] = [];
  // renderNote가 캐시한 Float32Array를 그대로 키로 쓴다
  const bufferCache = new WeakMap<Float32Array, AudioBuffer>();

  // 채널마다 게인 + 분석 노드를 하나씩 둔다.
  //  · 볼륨을 노드에 담으면 재생 중 조절이 즉시 반영된다(예전에는 다음 노트부터).
  //  · 분석 노드에서 파형을 뽑아 채널별 미터를 그린다.
  // 노드 풀은 MAX_CHANNELS개로 고정해 두고 인덱스를 재사용한다 — 채널을 지워도
  // 노드를 다시 만들지 않으므로 재생 중 제거가 계속 안전하다.
  interface ChannelNodes {
    /** 노트가 연결되는 입력 게인 노드 — 볼륨은 input.gain.value로 넣어야 한다
        (노드 자체의 .value에 쓰면 조용히 무시된다) */
    input: GainNode;
    analyser: AnalyserNode;
  }
  let channelNodes: ChannelNodes[] = [];
  let masterGain: GainNode | null = null;
  let masterAnalyser: AnalyserNode | null = null;

  function ensureAudioContext(): AudioContext {
    audioContext ??= new AudioContext();
    if (audioContext.state === 'suspended') void audioContext.resume();
    if (channelNodes.length === 0) {
      const context = audioContext;
      masterGain = context.createGain();
      masterAnalyser = context.createAnalyser();
      masterAnalyser.fftSize = 1024;
      masterGain.connect(masterAnalyser).connect(context.destination);
      channelNodes = Array.from({ length: MAX_CHANNELS }, () => {
        const input = context.createGain();
        const analyser = context.createAnalyser();
        analyser.fftSize = 512;
        input.connect(analyser).connect(masterGain!);
        return { input, analyser };
      });
      applyGains();
      requestAnimationFrame(drawMeters);
    }
    return audioContext;
  }

  /** 마지막으로 노트를 예약한 시각 — 소리가 잦아들면 미터 그리기를 멈춘다 */
  let lastNoteTime = 0;
  const scopeCanvases = [...document.querySelectorAll<HTMLCanvasElement>('[data-scope]')];
  const masterScope = el<HTMLCanvasElement>('master-scope');
  const clipFlag = el<HTMLSpanElement>('clip-flag');
  /** 클립이 뜬 시각 — 잠깐 켜 두었다 끈다 */
  let lastClipTime = 0;

  /**
   * 채널·마스터 파형을 실시간으로 그린다.
   * 파형이 위아래 벽에 닿으면(±1 근처) 그 채널이 넘치고 있다는 뜻이라, 사용자가
   * 볼륨을 얼마나 내려야 하는지 눈으로 판단할 수 있다.
   */
  function drawScope(canvas: HTMLCanvasElement, analyser: AnalyserNode, accent: string): number {
    const context = canvas.getContext('2d')!;
    const width = canvas.width;
    const height = canvas.height;
    const data = new Uint8Array(analyser.fftSize);
    analyser.getByteTimeDomainData(data);

    context.clearRect(0, 0, width, height);
    // 가운데 기준선
    context.strokeStyle = 'rgba(128, 128, 128, 0.35)';
    context.lineWidth = 1;
    context.beginPath();
    context.moveTo(0, height / 2);
    context.lineTo(width, height / 2);
    context.stroke();

    let peak = 0;
    context.strokeStyle = accent;
    context.lineWidth = 1.5;
    context.beginPath();
    for (let x = 0; x < width; x++) {
      const value = (data[Math.floor((x / width) * data.length)] - 128) / 128;
      peak = Math.max(peak, Math.abs(value));
      const y = height / 2 - value * (height / 2 - 1);
      if (x === 0) context.moveTo(x, y);
      else context.lineTo(x, y);
    }
    context.stroke();
    return peak;
  }

  function drawMeters() {
    if (!audioContext || channelNodes.length === 0) return;
    // 재생이 멈추고 소리가 잦아들면 그리기를 쉰다 (배터리·CPU 절약)
    const idle = !playing && audioContext.currentTime - lastNoteTime > 1.5;
    if (!idle) {
      const styles = getComputedStyle(document.documentElement);
      for (let channelIndex = 0; channelIndex < scopeCanvases.length; channelIndex++) {
        const canvas = scopeCanvases[channelIndex];
        if (canvas.closest('.channel-row')?.hasAttribute('hidden')) continue;
        const color =
          styles.getPropertyValue(`--channel-${channelIndex}`).trim() || 'currentColor';
        const peak = drawScope(canvas, channelNodes[channelIndex].analyser, color);
        canvas.classList.toggle('hot', peak >= 0.98);
      }
      const masterPeak = drawScope(
        masterScope,
        masterAnalyser!,
        styles.getPropertyValue('--accent').trim() || 'currentColor',
      );
      // 마스터에서 벽에 닿으면 실제로 잘려 나가는 중이다
      if (masterPeak >= 0.99) lastClipTime = audioContext.currentTime;
      clipFlag.hidden = audioContext.currentTime - lastClipTime > 1;
      masterScope.classList.toggle('hot', !clipFlag.hidden);
    }
    requestAnimationFrame(drawMeters);
  }

  /** 게인 노드 값을 곡 상태에서 다시 읽는다 (볼륨·음소거·마스터 변경 시) */
  function applyGains() {
    if (!masterGain) return;
    masterGain.gain.value = masterVolume();
    channelNodes.forEach((nodes, channelIndex) => {
      const channel = song.channels[channelIndex];
      // 0.5 = 채널 중첩 헤드룸 (mixSong의 WAV 내보내기와 같은 식)
      nodes.input.gain.value = !channel || channel.muted ? 0 : channel.volume * 0.5;
    });
  }

  function getAudioBuffer(samples: Float32Array<ArrayBuffer>): AudioBuffer {
    let buffer = bufferCache.get(samples);
    if (!buffer) {
      buffer = ensureAudioContext().createBuffer(1, samples.length, SAMPLE_RATE);
      buffer.copyToChannel(samples, 0);
      bufferCache.set(samples, buffer);
    }
    return buffer;
  }

  function playNoteAt(channelIndex: number, noteIndex: number, time: number) {
    const channel = song.channels[channelIndex];
    const samples = renderNote(channel.instrument.params, noteIndex);
    if (samples.length === 0) return;
    const context = ensureAudioContext();
    const source = context.createBufferSource();
    source.buffer = getAudioBuffer(samples);
    // 볼륨·음소거·마스터는 채널 게인 노드가 담당한다
    source.connect(channelNodes[channelIndex].input);
    source.start(time);
    lastNoteTime = context.currentTime;
    activeSources.add(source);
    source.addEventListener('ended', () => activeSources.delete(source));
  }

  const totalSteps = () =>
    playMode === 'pattern' ? PATTERN_STEPS : song.sequence.length * PATTERN_STEPS;

  const patternIndexAtStep = (step: number) =>
    playMode === 'pattern'
      ? currentPatternIndex
      : song.sequence[Math.floor(step / PATTERN_STEPS)] ?? 0;

  function scheduleStep(step: number, time: number) {
    const pattern = song.patterns[patternIndexAtStep(step)];
    if (!pattern) return;
    const stepInPattern = step % PATTERN_STEPS;
    for (let channelIndex = 0; channelIndex < song.channels.length; channelIndex++) {
      const channel = song.channels[channelIndex];
      if (channel.muted || channel.volume === 0) continue;
      const note = pattern.notes[channelIndex]?.[stepInPattern] ?? null;
      if (note !== null) playNoteAt(channelIndex, note, time);
    }
  }

  function schedulerTick() {
    const context = audioContext!;
    while (nextStepTime < context.currentTime + SCHEDULE_AHEAD_SECONDS) {
      const step = globalStep % totalSteps();
      scheduleStep(step, nextStepTime);
      stepQueue.push({ step, time: nextStepTime });
      nextStepTime += stepDuration(song.bpm);
      globalStep++;
    }
  }

  function drawPlayhead() {
    if (!playing) return;
    const context = audioContext!;
    let latest: { step: number; time: number } | null = null;
    while (stepQueue.length > 0 && stepQueue[0].time <= context.currentTime) {
      latest = stepQueue.shift()!;
    }
    if (latest) {
      // 곡 모드에서는 재생 중인 패턴을 화면이 따라간다
      const playingPattern = patternIndexAtStep(latest.step);
      if (playingPattern !== currentPatternIndex && song.patterns[playingPattern]) {
        currentPatternIndex = playingPattern;
        renderPatternList();
        renderGrid();
      }
      setPlayingColumn(latest.step % PATTERN_STEPS);
    }
    requestAnimationFrame(drawPlayhead);
  }

  function startPlayback() {
    const context = ensureAudioContext();
    playing = true;
    globalStep = 0;
    stepQueue.length = 0;
    nextStepTime = context.currentTime + 0.06;
    playToggle.textContent = '⏹ 정지';
    schedulerTick();
    timer = window.setInterval(schedulerTick, 25);
    requestAnimationFrame(drawPlayhead);
  }

  function stopPlayback() {
    playing = false;
    window.clearInterval(timer);
    for (const source of activeSources) {
      try {
        source.stop();
      } catch {
        // 이미 끝난 소스는 무시
      }
    }
    activeSources.clear();
    stepQueue.length = 0;
    setPlayingColumn(-1);
    playToggle.textContent = '▶ 재생';
  }

  playToggle.addEventListener('click', () => (playing ? stopPlayback() : startPlayback()));

  for (const [button, mode] of [
    [modePatternButton, 'pattern'],
    [modeSongButton, 'song'],
  ] as const) {
    button.addEventListener('click', () => {
      playMode = mode;
      modePatternButton.setAttribute('aria-pressed', String(mode === 'pattern'));
      modeSongButton.setAttribute('aria-pressed', String(mode === 'song'));
      if (playing) {
        stopPlayback();
        startPlayback();
      }
    });
  }

  bpmInput.addEventListener('change', () => {
    song.bpm = Math.min(240, Math.max(60, Number(bpmInput.value) || 120));
    bpmInput.value = String(song.bpm);
    persist();
  });

  masterVolumeSlider.addEventListener('input', () => {
    masterValue.textContent = `${masterVolumeSlider.value}%`;
    applyGains();
  });

  // ---------- 피아노롤 ----------

  // cells[노트][스텝] — 위쪽 행이 높은 음(B5)
  const cells: HTMLButtonElement[][] = Array.from({ length: NOTE_COUNT }, () => []);
  let playingColumn = -1;

  function buildGrid() {
    for (let noteIndex = NOTE_COUNT - 1; noteIndex >= 0; noteIndex--) {
      const label = document.createElement('span');
      label.className = 'roll-label';
      if (noteIndex % 12 === 11) label.classList.add('octave-top');
      label.textContent = noteLabel(noteIndex);
      rollGrid.append(label);
      for (let step = 0; step < PATTERN_STEPS; step++) {
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'cell';
        if (isBlackKey(noteIndex)) cell.classList.add('black');
        if (step % 4 === 0) cell.classList.add('beat');
        if (noteIndex % 12 === 11) cell.classList.add('octave-top');
        cell.setAttribute('aria-label', `${noteLabel(noteIndex)} · 스텝 ${step + 1}`);
        cell.addEventListener('click', () => onCellClick(noteIndex, step));
        rollGrid.append(cell);
        cells[noteIndex][step] = cell;
      }
    }
  }

  function onCellClick(noteIndex: number, step: number) {
    clearUndo();
    const notes = song.patterns[currentPatternIndex].notes[currentChannelIndex];
    if (notes[step] === noteIndex) {
      notes[step] = null;
    } else {
      notes[step] = noteIndex;
      // 찍은 음을 바로 들려준다 (클릭 = 사용자 제스처라 AudioContext 생성 가능)
      playNoteAt(currentChannelIndex, noteIndex, ensureAudioContext().currentTime);
    }
    persist();
    renderGrid();
  }

  function renderGrid() {
    const pattern = song.patterns[currentPatternIndex];
    // 노트/고스트 색이 채널 색을 따라가도록 그리드에 현재 채널 클래스를 단다
    for (let channelIndex = 0; channelIndex < MAX_CHANNELS; channelIndex++) {
      rollGrid.classList.toggle(`ch-${channelIndex}`, channelIndex === currentChannelIndex);
    }
    // 다른 채널 노트는 그 채널 색의 흐린 점으로 겹쳐 보여준다
    const ghostChannels = new Map<string, number>();
    for (let channelIndex = 0; channelIndex < song.channels.length; channelIndex++) {
      if (channelIndex === currentChannelIndex) continue;
      pattern.notes[channelIndex].forEach((note, step) => {
        const key = `${note}:${step}`;
        if (note !== null && !ghostChannels.has(key)) ghostChannels.set(key, channelIndex);
      });
    }
    const ownNotes = pattern.notes[currentChannelIndex];
    for (let noteIndex = 0; noteIndex < NOTE_COUNT; noteIndex++) {
      for (let step = 0; step < PATTERN_STEPS; step++) {
        const cell = cells[noteIndex][step];
        const ghostChannel = ghostChannels.get(`${noteIndex}:${step}`);
        cell.classList.toggle('active', ownNotes[step] === noteIndex);
        for (let channelIndex = 0; channelIndex < MAX_CHANNELS; channelIndex++) {
          cell.classList.toggle(`ghost-${channelIndex}`, ghostChannel === channelIndex);
        }
      }
    }
  }

  function setPlayingColumn(column: number) {
    if (column === playingColumn) return;
    for (let noteIndex = 0; noteIndex < NOTE_COUNT; noteIndex++) {
      if (playingColumn >= 0) cells[noteIndex][playingColumn].classList.remove('playing');
      if (column >= 0) cells[noteIndex][column].classList.add('playing');
    }
    playingColumn = column;
  }

  // ---------- 채널 (믹서) ----------
  //
  // 채널마다 악기·볼륨·음소거를 항상 펼쳐 둔다 — 볼륨을 만지려고 탭을 먼저
  // 고르지 않아도 되게 하기 위해서다. 번호 버튼은 피아노롤의 편집 대상만 정한다.
  // GlassSlider가 Astro 컴포넌트라 JS로 만들 수 없어, 최대 채널 수만큼 미리
  // 렌더해 두고 곡의 채널 수를 넘는 행은 hidden으로 감춘다.

  function renderInstrumentOptions() {
    for (let channelIndex = 0; channelIndex < channelRows.length; channelIndex++) {
      const select = instrumentSelects[channelIndex];
      select.innerHTML = '';
      const builtinGroup = document.createElement('optgroup');
      builtinGroup.label = '내장 악기';
      BUILTIN_INSTRUMENTS.forEach((instrument, index) => {
        const option = document.createElement('option');
        option.value = `builtin:${index}`;
        option.textContent = instrument.name;
        builtinGroup.append(option);
      });
      select.append(builtinGroup);

      const sounds = listSounds();
      if (sounds.length > 0) {
        const storedGroup = document.createElement('optgroup');
        storedGroup.label = 'SFX 보관함';
        for (const sound of sounds) {
          const option = document.createElement('option');
          option.value = `stored:${sound.id}`;
          option.textContent = sound.name;
          storedGroup.append(option);
        }
        select.append(storedGroup);
      }

      // 저장본과 일치하지 않는 악기(가져온 곡 등)를 위한 자리 표시
      const currentOption = document.createElement('option');
      currentOption.value = 'current';
      currentOption.hidden = true;
      select.append(currentOption);
    }
  }

  function renderChannelControls() {
    const stored = listSounds();
    const count = song.channels.length;
    for (let channelIndex = 0; channelIndex < channelRows.length; channelIndex++) {
      channelRows[channelIndex].hidden = channelIndex >= count;
      // 마지막 하나는 지울 수 없다
      removeButtons[channelIndex].disabled = count <= 1;
    }
    addChannelButton.disabled = count >= MAX_CHANNELS;
    channelCountHint.textContent =
      count >= MAX_CHANNELS ? `채널 ${count}개 (최대)` : `채널 ${count}개 · 최대 ${MAX_CHANNELS}개`;

    song.channels.forEach((channel, channelIndex) => {
      const select = instrumentSelects[channelIndex];
      const builtinIndex = BUILTIN_INSTRUMENTS.findIndex(
        (instrument) => instrument.name === channel.instrument.name,
      );
      const storedSound = stored.find((sound) => sound.name === channel.instrument.name);
      if (builtinIndex >= 0) {
        select.value = `builtin:${builtinIndex}`;
      } else if (storedSound) {
        select.value = `stored:${storedSound.id}`;
      } else {
        const currentOption = select.querySelector<HTMLOptionElement>('[value="current"]')!;
        currentOption.textContent = `(현재: ${channel.instrument.name})`;
        select.value = 'current';
      }

      const percent = Math.round(channel.volume * 100);
      volumeSliders[channelIndex].value = String(percent);
      document.querySelector(`[data-volume-for="${channelIndex}"]`)!.textContent = `${percent}%`;
      muteToggles[channelIndex].checked = channel.muted;

      const row = channelRows[channelIndex];
      row.classList.toggle('active', channelIndex === currentChannelIndex);
      row.classList.toggle('muted', channel.muted);
      pickButtons[channelIndex].setAttribute(
        'aria-pressed',
        String(channelIndex === currentChannelIndex),
      );
    });
  }

  function selectChannel(channelIndex: number) {
    currentChannelIndex = channelIndex;
    renderChannelControls();
    renderGrid();
  }

  // 상수가 아니라 실제 행 수를 도는 것이 중요하다 — 둘이 어긋나면 undefined에
  // 리스너를 걸다 초기화 전체가 멈춘다(한 번 겪은 버그)
  for (let channelIndex = 0; channelIndex < channelRows.length; channelIndex++) {
    pickButtons[channelIndex].addEventListener('click', () => selectChannel(channelIndex));

    instrumentSelects[channelIndex].addEventListener('change', () => {
      const value = instrumentSelects[channelIndex].value;
      const channel = song.channels[channelIndex];
      if (value.startsWith('builtin:')) {
        channel.instrument = cloneInstrument(BUILTIN_INSTRUMENTS[Number(value.slice(8))]);
      } else if (value.startsWith('stored:')) {
        const sound = listSounds().find((item) => item.id === value.slice(7));
        if (sound) channel.instrument = { name: sound.name, params: { ...sound.params } };
      }
      persist();
      renderChannelControls();
      // 바뀐 음색을 바로 들려준다
      playNoteAt(channelIndex, 12, ensureAudioContext().currentTime);
    });

    volumeSliders[channelIndex].addEventListener('input', () => {
      const percent = Number(volumeSliders[channelIndex].value);
      song.channels[channelIndex].volume = percent / 100;
      document.querySelector(`[data-volume-for="${channelIndex}"]`)!.textContent = `${percent}%`;
      applyGains();
      persist();
    });

    muteToggles[channelIndex].addEventListener('change', () => {
      song.channels[channelIndex].muted = muteToggles[channelIndex].checked;
      applyGains();
      persist();
      renderChannelControls();
    });

    removeButtons[channelIndex].addEventListener('click', () => {
      // 재생 중에도 그대로 제거한다 — 스케줄러는 스텝마다 song.channels를 다시 읽고,
      // 이미 예약된 노트(최대 0.12초 앞)는 채널과 무관한 원샷이라 그냥 울리고 끝난다
      const removed = removeChannel(song, channelIndex);
      if (!removed) {
        setStatus('마지막 채널은 지울 수 없습니다.');
        return;
      }
      if (currentChannelIndex >= song.channels.length) {
        currentChannelIndex = song.channels.length - 1;
      }
      persist();
      renderChannelControls();
      renderGrid();
      offerUndo(`채널 ${channelIndex + 1}(${removed.channel.instrument.name})을 지웠습니다.`, () => {
        restoreChannel(song, removed);
        currentChannelIndex = removed.index;
        persist();
        renderChannelControls();
        renderGrid();
        setStatus(`채널 ${removed.index + 1}을 되살렸습니다.`);
      });
    });

    clearChannelButtons[channelIndex].addEventListener('click', () => {
      const notes = song.patterns[currentPatternIndex].notes[channelIndex];
      if (notes.every((note) => note === null)) {
        setStatus(`채널 ${channelIndex + 1}은 이미 비어 있습니다.`);
        return;
      }
      const before = [...notes];
      const patternIndex = currentPatternIndex;
      notes.fill(null);
      persist();
      renderGrid();
      offerUndo(`패턴 ${patternIndex + 1}의 채널 ${channelIndex + 1}을 비웠습니다.`, () => {
        song.patterns[patternIndex].notes[channelIndex] = before;
        persist();
        renderGrid();
        setStatus('되돌렸습니다.');
      });
    });
  }

  addChannelButton.addEventListener('click', () => {
    // 새 채널의 악기는 아직 안 쓴 내장 악기 중에서 고른다
    const used = new Set(song.channels.map((channel) => channel.instrument.name));
    const fresh =
      BUILTIN_INSTRUMENTS.find((instrument) => !used.has(instrument.name)) ?? BUILTIN_INSTRUMENTS[0];
    if (!addChannel(song, fresh)) {
      setStatus(`채널은 최대 ${MAX_CHANNELS}개까지 만들 수 있습니다.`);
      return;
    }
    currentChannelIndex = song.channels.length - 1;
    persist();
    renderInstrumentOptions();
    renderChannelControls();
    renderGrid();
    setStatus(`채널 ${song.channels.length}(${fresh.name})을 추가했습니다.`);
  });

  // ---------- 패턴 · 시퀀스 ----------

  function renderPatternList() {
    patternList.innerHTML = '';
    song.patterns.forEach((_, patternIndex) => {
      const chip = document.createElement('button');
      chip.type = 'button';
      chip.className = 'btn btn-small pattern-chip';
      chip.setAttribute('aria-pressed', String(patternIndex === currentPatternIndex));
      chip.textContent = String(patternIndex + 1);
      chip.addEventListener('click', () => {
        currentPatternIndex = patternIndex;
        renderPatternList();
        renderGrid();
      });
      patternList.append(chip);
    });
  }

  function renderSequenceList() {
    sequenceList.innerHTML = '';
    song.sequence.forEach((patternIndex, position) => {
      const chip = document.createElement('span');
      chip.className = 'seq-chip';
      const label = document.createElement('span');
      label.textContent = String(patternIndex + 1);
      chip.append(label);
      const moveLeft = document.createElement('button');
      moveLeft.type = 'button';
      moveLeft.textContent = '◀';
      moveLeft.disabled = position === 0;
      moveLeft.addEventListener('click', () => {
        [song.sequence[position - 1], song.sequence[position]] = [
          song.sequence[position],
          song.sequence[position - 1],
        ];
        persist();
        renderSequenceList();
      });
      const moveRight = document.createElement('button');
      moveRight.type = 'button';
      moveRight.textContent = '▶';
      moveRight.disabled = position === song.sequence.length - 1;
      moveRight.addEventListener('click', () => {
        [song.sequence[position], song.sequence[position + 1]] = [
          song.sequence[position + 1],
          song.sequence[position],
        ];
        persist();
        renderSequenceList();
      });
      const remove = document.createElement('button');
      remove.type = 'button';
      remove.textContent = '×';
      remove.addEventListener('click', () => {
        if (song.sequence.length <= 1) {
          setStatus('시퀀스에는 최소 한 개의 패턴이 필요합니다.');
          return;
        }
        song.sequence.splice(position, 1);
        persist();
        renderSequenceList();
      });
      chip.append(moveLeft, moveRight, remove);
      sequenceList.append(chip);
    });
  }

  el<HTMLButtonElement>('pattern-add').addEventListener('click', () => {
    if (song.patterns.length >= MAX_PATTERNS) {
      setStatus(`패턴은 최대 ${MAX_PATTERNS}개까지 만들 수 있습니다.`);
      return;
    }
    song.patterns.push(emptyPattern());
    currentPatternIndex = song.patterns.length - 1;
    persist();
    renderPatternList();
    renderGrid();
  });

  el<HTMLButtonElement>('pattern-clone').addEventListener('click', () => {
    if (song.patterns.length >= MAX_PATTERNS) {
      setStatus(`패턴은 최대 ${MAX_PATTERNS}개까지 만들 수 있습니다.`);
      return;
    }
    const clone = emptyPattern();
    song.patterns[currentPatternIndex].notes.forEach((row, channelIndex) => {
      clone.notes[channelIndex] = [...row];
    });
    song.patterns.push(clone);
    currentPatternIndex = song.patterns.length - 1;
    persist();
    renderPatternList();
    renderGrid();
  });

  el<HTMLButtonElement>('pattern-delete').addEventListener('click', () => {
    if (song.patterns.length <= 1) {
      setStatus('마지막 패턴은 삭제할 수 없습니다.');
      return;
    }
    const removed = currentPatternIndex;
    song.patterns.splice(removed, 1);
    song.sequence = song.sequence
      .filter((patternIndex) => patternIndex !== removed)
      .map((patternIndex) => (patternIndex > removed ? patternIndex - 1 : patternIndex));
    if (song.sequence.length === 0) song.sequence = [0];
    currentPatternIndex = Math.min(currentPatternIndex, song.patterns.length - 1);
    persist();
    renderPatternList();
    renderSequenceList();
    renderGrid();
  });

  el<HTMLButtonElement>('pattern-clear').addEventListener('click', () => {
    const patternIndex = currentPatternIndex;
    const pattern = song.patterns[patternIndex];
    if (pattern.notes.every((row) => row.every((note) => note === null))) {
      setStatus('이미 비어 있는 패턴입니다.');
      return;
    }
    const before = pattern.notes.map((row) => [...row]);
    for (const row of pattern.notes) row.fill(null);
    persist();
    renderGrid();
    offerUndo(`패턴 ${patternIndex + 1}의 모든 채널을 비웠습니다.`, () => {
      song.patterns[patternIndex].notes = before;
      persist();
      renderGrid();
      setStatus('되돌렸습니다.');
    });
  });

  // 악기·볼륨·BPM은 그대로 두고 노트만 지운다 ("새 곡"과 다른 점)
  el<HTMLButtonElement>('song-clear').addEventListener('click', () => {
    stopPlayback();
    const before = song.patterns.map((pattern) => pattern.notes.map((row) => [...row]));
    for (const pattern of song.patterns) {
      for (const row of pattern.notes) row.fill(null);
    }
    persist();
    renderGrid();
    offerUndo('모든 패턴을 비웠습니다.', () => {
      song.patterns.forEach((pattern, patternIndex) => {
        pattern.notes = before[patternIndex];
      });
      persist();
      renderGrid();
      setStatus('되돌렸습니다.');
    });
  });

  el<HTMLButtonElement>('sequence-add').addEventListener('click', () => {
    if (song.sequence.length >= MAX_SEQUENCE) {
      setStatus(`시퀀스는 최대 ${MAX_SEQUENCE}개까지 이어붙일 수 있습니다.`);
      return;
    }
    song.sequence.push(currentPatternIndex);
    persist();
    renderSequenceList();
  });

  // ---------- 내보내기 · 가져오기 ----------

  el<HTMLButtonElement>('export-wav').addEventListener('click', () => {
    setStatus('');
    const mixed = mixSong(song, masterVolume());
    const blob = new Blob([encodeWav(mixed, SAMPLE_RATE)], { type: 'audio/wav' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'chiptune-song.wav';
    anchor.click();
    URL.revokeObjectURL(url);
  });

  el<HTMLButtonElement>('export-json').addEventListener('click', () => {
    const blob = new Blob([JSON.stringify(song, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'chiptune-song.json';
    anchor.click();
    URL.revokeObjectURL(url);
  });

  el<HTMLButtonElement>('import-json').addEventListener('click', () => importInput.click());

  importInput.addEventListener('change', async () => {
    const file = importInput.files?.[0];
    importInput.value = '';
    if (!file) return;
    try {
      const restored = normalizeSong(JSON.parse(await file.text()));
      if (!restored) throw new Error('곡 형식이 아닙니다');
      stopPlayback();
      song = restored;
      currentPatternIndex = 0;
      currentChannelIndex = 0;
      persist();
      renderAll();
      setStatus('');
    } catch (e) {
      setStatus(`곡을 가져오지 못했습니다: ${e instanceof Error ? e.message : String(e)}`);
    }
  });

  for (const demoButton of document.querySelectorAll<HTMLButtonElement>('[data-demo]')) {
    demoButton.addEventListener('click', () => void loadDemo(demoButton));
  }

  async function loadDemo(button: HTMLButtonElement) {
    const source = button.dataset.demo!;
    const name = button.dataset.demoName ?? '예시 곡';
    const previous = JSON.stringify(song);
    try {
      const response = await fetch(source);
      if (!response.ok) throw new Error(`HTTP ${response.status}`);
      const demo = normalizeSong(await response.json());
      if (!demo) throw new Error('곡 형식이 아닙니다');
      stopPlayback();
      song = demo;
      currentPatternIndex = 0;
      currentChannelIndex = 0;
      persist();
      renderAll();
      setStatus('');
      // 버튼 클릭 = 사용자 제스처이므로 바로 곡 전체를 들려준다
      playMode = 'song';
      modePatternButton.setAttribute('aria-pressed', 'false');
      modeSongButton.setAttribute('aria-pressed', 'true');
      startPlayback();
      offerUndo(`예시 곡 "${name}"을 불러왔습니다.`, () => {
        stopPlayback();
        song = normalizeSong(JSON.parse(previous)) ?? defaultSong();
        currentPatternIndex = 0;
        currentChannelIndex = 0;
        persist();
        renderAll();
        setStatus('이전 곡으로 되돌렸습니다.');
      });
    } catch (e) {
      setStatus(`예시 곡을 불러오지 못했습니다: ${e instanceof Error ? e.message : String(e)}`);
    }
  }

  el<HTMLButtonElement>('reset-song').addEventListener('click', () => {
    const previous = JSON.stringify(song);
    stopPlayback();
    song = defaultSong();
    currentPatternIndex = 0;
    currentChannelIndex = 0;
    persist();
    renderAll();
    offerUndo('새 곡을 시작했습니다.', () => {
      song = normalizeSong(JSON.parse(previous)) ?? defaultSong();
      currentPatternIndex = 0;
      currentChannelIndex = 0;
      persist();
      renderAll();
      setStatus('이전 곡으로 되돌렸습니다.');
    });
  });

  // ---------- 초기화 ----------

  function renderAll() {
    bpmInput.value = String(song.bpm);
    renderInstrumentOptions();
    renderChannelControls();
    renderPatternList();
    renderSequenceList();
    renderGrid();
  }

  buildGrid();
  renderAll();

  undoButton.addEventListener('click', () => {
    const undo = pendingUndo;
    clearUndo();
    undo?.apply();
  });

  // 다른 탭의 SFX 페이지에서 보관함에 저장하고 돌아오면 악기 목록을 갱신한다
  window.addEventListener('focus', () => {
    renderInstrumentOptions();
    renderChannelControls();
  });

  // 페이지를 떠나면 재생을 정리한다
  window.addEventListener('pagehide', stopPlayback);
</script>

<style>
  main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
    /* 채널 고유 색 — 믹서 행·노트·고스트 점이 함께 쓴다 (최대 8채널) */
    --channel-0: #4263eb;
    --channel-1: #0ca678;
    --channel-2: #e8590c;
    --channel-3: #d6336c;
    --channel-4: #7048e8;
    --channel-5: #099268;
    --channel-6: #f08c00;
    --channel-7: #1098ad;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.6rem;
  }

  .intro p {
    color: var(--text-dim);
    line-height: 1.6;
    margin: 0;
  }

  .intro a {
    color: var(--accent);
  }

  .toolbar,
  .patterns,
  .exports {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  /* 채널 4개를 항상 펼쳐 두는 믹서 — 볼륨을 만지려고 탭을 고를 필요가 없다 */
  .channels {
    display: grid;
    gap: 0.35rem;
    margin-top: 1rem;
  }

  .channel-row {
    display: grid;
    grid-template-columns:
      2rem minmax(6.5rem, 10rem) minmax(5rem, 1fr) 2.8rem minmax(3rem, 6rem)
      auto auto auto;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-left: 4px solid var(--row-color);
    border-radius: 0.6rem;
  }

  .channel-row.active {
    background: color-mix(in srgb, var(--row-color) 12%, transparent);
    border-color: color-mix(in srgb, var(--row-color) 55%, var(--border));
    border-left-color: var(--row-color);
  }

  .channel-row.muted {
    opacity: 0.55;
  }

  .channel-row[hidden] {
    display: none;
  }

  .scope {
    width: 100%;
    max-width: 6rem;
    height: 26px;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0.35rem;
  }

  /* 파형이 위아래 벽에 닿는 중 — 이 채널이 넘치고 있다는 신호 */
  .scope.hot,
  #master-scope.hot {
