---

<Layout
  title="링크 모음 — Killterm"
  description="자주 쓰는 게임 관련 사이트 모음: 플레이 타임, 통계, 최저가, 컨트롤러 도구 등."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>🔗 링크 모음</h1>
      <p>자주 쓰는 게임 관련 사이트 모음입니다.</p>
    </header>

    <section class="grid" aria-label="링크 목록">
      {
        categories.map((cat) => (
          <div class="card">
            <h2>{cat.name}</h2>
            <ul>
              {cat.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    <span class="label">{link.label}</span>
                    <span class="desc">{link.description}</span>
                    <span class="domain">{new URL(link.url).hostname.replace(/^www\./, '')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .intro p {
    color: var(--text-dim);
    margin: 0 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.1rem 1.25rem;
  }

  .card h2 {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .card a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .card a:hover,
  .card a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .domain {
    font-size: 0.75rem;
    color: var(--text-dim);
    opacity: 0.65;
  }
</style>
