---
import Layout from '../layouts/Layout.astro';

// 이동 시 출처를 알리는 쿼리 파라미터 (기존 쿼리가 있어도 안전하게 추가됨)
const REF_SOURCE = 'killterm.github.io';
function withRef(url: string): string {
  const u = new URL(url);
  u.searchParams.set('utm_source', REF_SOURCE);
  return u.toString();
}

const categories = [
  {
    name: '게임 정보',
    links: [
      { label: 'HowLongToBeat (플레이 타임)', url: 'https://howlongtobeat.com/' },
      { label: 'MapGenie (지도)', url: 'https://mapgenie.io/' },
      { label: 'Delisted Games Watch List (판매 중단)', url: 'https://delistedgames.com/watch-list/' },
    ],
  },
  {
    name: 'Steam DB',
    links: [
      { label: 'SteamDB', url: 'https://steamdb.info/' },
      { label: 'IsThereAnyDeal', url: 'https://isthereanydeal.com/' },
      { label: 'Game Bundle Guardian', url: 'https://gamebundleguardian.com/' },
    ],
  },
  {
    name: 'Steam 통계',
    links: [
      { label: 'Steam250', url: 'https://steam250.com/' },
      { label: 'Games Stats', url: 'https://games-stats.com/' },
    ],
  },
  {
    name: 'Steam 동시접속자',
    links: [
      { label: 'SteamDB Charts', url: 'https://steamdb.info/charts/' },
      { label: 'Steam 공식 차트', url: 'https://store.steampowered.com/charts/' },
    ],
  },
  {
    name: 'Steam 리뷰 요약',
    links: [
      { label: 'Compath', url: 'https://compath.vercel.app/' },
      { label: 'Vaporlens', url: 'https://vaporlens.app/' },
    ],
  },
  {
    name: 'PS DB',
    links: [{ label: 'PSprices (KR)', url: 'https://psprices.com/region-kr/index' }],
  },
  {
    name: '위키',
    links: [{ label: 'PCGamingWiki', url: 'https://www.pcgamingwiki.com/' }],
  },
  {
    name: '컨트롤러',
    links: [
      { label: 'Gamepad Tester (테스트)', url: 'https://gamepad-tester.com/' },
      { label: 'Gamepad Viewer (캡쳐)', url: 'https://gamepadviewer.com/?p=1&s=8' },
    ],
  },
  {
    name: '폰트 정보',
    links: [
      { label: 'Font Info', url: 'https://fontinfo.app/' },
      { label: '눈누', url: 'https://noonnu.cc/index' },
    ],
  },
  {
    name: '크롬 확장 프로그램',
    links: [
      {
        label: 'SteamDB',
        url: 'https://chromewebstore.google.com/detail/steamdb/kdbmhfkmnlmbkgbabkdealhhbfhlmmon',
      },
      {
        label: 'Augmented Steam',
        url: 'https://chromewebstore.google.com/detail/augmented-steam/dnhpnfgdlenaccegplpojghhmaamnnfp',
      },
      {
        label: "alike03's Subscription Info on Steam",
        url: 'https://chromewebstore.google.com/detail/alike03s-subscription-inf/jecikjbpiedagpmibmgpfgnkfpomgeok',
      },
      {
        label: 'KOSTEAM',
        url: 'https://chromewebstore.google.com/detail/kosteam/cbcganplchikpgchgppklcblpjibhnnc',
      },
    ],
  },
];
---

<Layout
  title="링크 모음 — Killterm"
  description="자주 쓰는 게임 관련 사이트 모음: 플레이 타임, 통계, 최저가, 컨트롤러 도구 등."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>🔗 링크 모음</h1>
      <p>자주 쓰는 게임 관련 사이트 모음입니다.</p>
    </header>

    <section class="grid" aria-label="링크 목록">
      {
        categories.map((cat) => (
          <div class="card">
            <h2>{cat.name}</h2>
            <ul>
              {cat.links.map((link) => (
                <li>
                  <a href={withRef(link.url)} target="_blank" rel="noopener noreferrer">
                    <span class="label">{link.label}</span>
                    <span class="domain">{new URL(link.url).hostname.replace(/^www\./, '')}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>
  </main>
</Layout>

<style>
  main {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    letter-spacing: -0.02em;
  }

  .intro p {
    color: var(--text-dim);
    margin: 0 0 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .card {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 1rem;
    padding: 1.1rem 1.25rem;
  }

  .card h2 {
    margin: 0 0 0.6rem;
    font-size: 0.95rem;
    color: var(--text-dim);
    font-weight: 600;
  }

  .card ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.4rem;
  }

  .card a {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.6rem;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .card a:hover,
  .card a:focus-visible {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .domain {
    font-size: 0.78rem;
    color: var(--text-dim);
  }
</style>
