---
import Layout from '../layouts/Layout.astro';

const apps = [
  {
    name: '만다라트',
    description: '생각을 9×9 칸에 정리해 이미지로 저장하기',
    icon: '📋',
    href: '/mandalart/',
    ready: true,
  },
  {
    name: '인코딩 변환',
    description: 'Base64 · URL(%) · UTF-8 인코딩/디코딩',
    icon: '🔤',
    href: '/encode/',
    ready: true,
  },
  {
    name: '링크 모음',
    description: '자주 쓰는 게임 관련 사이트 모음',
    icon: '🔗',
    href: '/links/',
    ready: true,
  },
  {
    name: 'Coming soon',
    description: '준비 중입니다',
    icon: '✨',
    href: '#',
    ready: false,
  },
];
---

<Layout title="killterm — 작은 도구 모음">
  <main>
    <header class="hero">
      <h1>killterm</h1>
      <p>
        일상에서 바로 쓸 수 있는 작은 웹 도구들을 만듭니다.<br />
        아래에서 원하는 도구를 골라보세요.
      </p>
    </header>

    <section class="launchpad" aria-label="도구 목록">
      {
        apps.map((app) =>
          app.ready ? (
            <a class="tile" href={app.href}>
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </a>
          ) : (
            <div class="tile tile-disabled" aria-disabled="true">
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </div>
          ),
        )
      }
    </section>

    <footer>
      <p>© {new Date().getFullYear()} killterm</p>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    background: linear-gradient(135deg, var(--text) 40%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p {
    color: var(--text-dim);
    margin: 0;
  }

  .launchpad {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  .tile {
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 1.25rem;
    text-decoration: none;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      background 0.15s ease;
  }

  a.tile:hover,
  a.tile:focus-visible {
    transform: translateY(-4px);
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .tile-icon {
    font-size: 2.4rem;
    line-height: 1;
    margin-bottom: 0.4rem;
  }

  .tile-name {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .tile-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .tile-disabled {
    opacity: 0.45;
    cursor: default;
  }

  footer {
    margin-top: 4rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
</style>
