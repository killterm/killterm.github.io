---
import Layout from '../layouts/Layout.astro';

const apps = [
  {
    name: '링크 모음',
    description: '자주 쓰는 게임 관련 사이트 모음',
    icon: '🔗',
    href: '/links/',
    ready: true,
  },
  {
    name: '인코딩 변환',
    description: '텍스트와 여러 바이트 표현을 서로 변환하고 해시 계산',
    icon: '🔤',
    href: '/encode/',
    ready: true,
  },
  {
    name: '만다라트',
    description: '생각을 9×9 칸에 정리해 이미지로 저장하기',
    icon: '📋',
    href: '/mandalart/',
    ready: true,
  },
  {
    name: '마인드맵',
    description: '주제에서 가지를 뻗어 내용을 정리하기',
    icon: '🧠',
    href: '/mindmap/',
    ready: true,
  },
  {
    name: '개발 도구',
    description: '타임스탬프 변환, JSON 정리, 정규식 테스트',
    icon: '🧰',
    href: '/devtools/timestamp/',
    ready: true,
  },
  {
    name: '하드웨어 테스트',
    description: '키보드·모니터·반응속도·사운드 확인',
    icon: '🖥️',
    href: '/hwtest/keyboard/',
    ready: true,
  },
  {
    name: 'GLB 뷰어',
    description: '3D 모델(GLB/GLTF)을 브라우저에서 바로 보기',
    icon: '🧊',
    href: '/glb/',
    ready: true,
  },
  {
    name: '다음 도구',
    description: '아이디어를 다듬고 있어요',
    icon: '🛠️',
    href: '#',
    ready: false,
  },
];
---

<Layout title="Killterm — 작은 도구 모음">
  <div class="glass-bg" aria-hidden="true">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
  </div>
  <main>
    <header class="hero">
      <h1>Killterm</h1>
      <p>
        일상에서 바로 쓸 수 있는 작은 웹 도구들을 만듭니다.<br />
        아래에서 원하는 도구를 골라보세요.
      </p>
    </header>

    <section class="launchpad" aria-label="도구 목록">
      {
        apps.map((app) =>
          app.ready ? (
            <a class="tile" href={app.href}>
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </a>
          ) : (
            <div class="tile tile-disabled" aria-disabled="true">
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </div>
          ),
        )
      }
    </section>

    <footer>
      <p>© {new Date().getFullYear()} Killterm</p>
    </footer>
  </main>
</Layout>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    background: linear-gradient(135deg, var(--text) 40%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p {
    color: var(--text-dim);
    margin: 0;
  }

  .launchpad {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  /* ---------- 리퀴드 글래스 배경 ----------
     backdrop-filter가 굴절시킬 대상이 있어야 유리 느낌이 나므로
     화면 뒤에 흐릿한 컬러 블롭을 깔아 둔다. */

  .glass-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    width: 45vmax;
    height: 45vmax;
    border-radius: 50%;
    filter: blur(90px);
    opacity: light-dark(0.22, 0.4);
    animation: blob-float 14s ease-in-out infinite;
  }

  .blob-a {
    top: -14%;
    left: -10%;
    background: #4263eb;
  }

  .blob-b {
    bottom: -20%;
    right: -12%;
    background: #7048e8;
    animation-delay: -5s;
  }

  .blob-c {
    top: 28%;
    left: 56%;
    width: 30vmax;
    height: 30vmax;
    background: #0ca678;
    animation-delay: -9s;
  }

  @keyframes blob-float {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(14vmax, -10vmax) scale(1.12);
    }
    66% {
      transform: translate(-8vmax, 12vmax) scale(0.94);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }

  /* ---------- 리퀴드 글래스 타일 ---------- */

  .tile {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem;
    text-align: center;
    background: linear-gradient(
      150deg,
      light-dark(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.09)),
      light-dark(rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0.03))
    );
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid light-dark(rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.14));
    border-radius: 1.6rem;
    box-shadow:
      0 10px 34px light-dark(rgba(28, 35, 51, 0.12), rgba(0, 0, 0, 0.35)),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.22));
    text-decoration: none;
    transition:
      transform 0.18s ease,
      border-color 0.18s ease,
      box-shadow 0.18s ease;
  }

  /* 유리 위쪽에 비치는 스펙큘러 하이라이트 */
  .tile::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(
      120% 70% at 22% 0%,
      light-dark(rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.13)),
      transparent 46%
    );
    pointer-events: none;
  }

  a.tile:hover,
  a.tile:focus-visible {
    transform: translateY(-5px) scale(1.02);
    border-color: light-dark(rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.3));
    box-shadow:
      0 16px 44px light-dark(rgba(28, 35, 51, 0.18), rgba(0, 0, 0, 0.5)),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.3));
  }

  a.tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* backdrop-filter 미지원 브라우저는 기존 면 색으로 강등 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .tile {
      background: var(--surface);
    }
  }

  .tile-icon {
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    font-size: 2.2rem;
    line-height: 1;
    margin-bottom: 0.4rem;
    border-radius: 1.35rem;
    background: light-dark(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.08));
    border: 1px solid light-dark(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.13));
    box-shadow:
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.2)),
      0 4px 14px light-dark(rgba(28, 35, 51, 0.1), rgba(0, 0, 0, 0.3));
  }

  .tile-name {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .tile-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .tile-disabled {
    opacity: 0.45;
    cursor: default;
  }

  footer {
    margin-top: 4rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
</style>
