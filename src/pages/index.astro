---
import Layout from '../layouts/Layout.astro';

const apps = [
  {
    name: '링크 모음',
    description: '자주 쓰는 게임 관련 사이트 모음',
    icon: '🔗',
    href: '/links/',
    ready: true,
  },
  {
    name: '인코딩 변환',
    description: '텍스트와 여러 바이트 표현을 서로 변환하고 해시 계산',
    icon: '🔤',
    href: '/encode/',
    ready: true,
  },
  {
    name: '만다라트',
    description: '생각을 9×9 칸에 정리해 이미지로 저장하기',
    icon: '📋',
    href: '/mandalart/',
    ready: true,
  },
  {
    name: '마인드맵',
    description: '주제에서 가지를 뻗어 내용을 정리하기',
    icon: '🧠',
    href: '/mindmap/',
    ready: true,
  },
  {
    name: '개발 도구',
    description: '타임스탬프 변환, JSON 정리, 정규식 테스트',
    icon: '🧰',
    href: '/devtools/timestamp/',
    ready: true,
  },
  {
    name: '하드웨어 테스트',
    description: '키보드·모니터·반응속도·사운드 확인',
    icon: '🖥️',
    href: '/hwtest/keyboard/',
    ready: true,
  },
  {
    name: '다음 도구',
    description: '아이디어를 다듬고 있어요',
    icon: '🛠️',
    href: '#',
    ready: false,
  },
];
---

<Layout title="Killterm — 작은 도구 모음">
  <div class="glass-bg" aria-hidden="true">
    <div class="blob blob-a"></div>
    <div class="blob blob-b"></div>
    <div class="blob blob-c"></div>
  </div>
  <svg class="glass-filter" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
    <filter
      id="glass-blur"
      x="0"
      y="0"
      width="100%"
      height="100%"
      filterUnits="objectBoundingBox"
    >
      <feTurbulence
        type="fractalNoise"
        baseFrequency="0.003 0.007"
        numOctaves="1"
        result="turbulence"
      />
      <feDisplacementMap
        in="SourceGraphic"
        in2="turbulence"
        scale="200"
        xChannelSelector="R"
        yChannelSelector="G"
      />
    </filter>
  </svg>
  <main>
    <header class="hero">
      <h1>Killterm</h1>
      <p>
        일상에서 바로 쓸 수 있는 작은 웹 도구들을 만듭니다.<br />
        아래에서 원하는 도구를 골라보세요.
      </p>
    </header>

    <section class="launchpad" aria-label="도구 목록">
      {
        apps.map((app) =>
          app.ready ? (
            <a class="tile" href={app.href}>
              <span class="tile-glass" aria-hidden="true">
                <span class="tile-glass-bend"></span>
                <span class="tile-glass-face"></span>
                <span class="tile-glass-edge"></span>
              </span>
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </a>
          ) : (
            <div class="tile tile-disabled" aria-disabled="true">
              <span class="tile-glass" aria-hidden="true">
                <span class="tile-glass-bend"></span>
                <span class="tile-glass-face"></span>
                <span class="tile-glass-edge"></span>
              </span>
              <span class="tile-icon" aria-hidden="true">
                {app.icon}
              </span>
              <span class="tile-name">{app.name}</span>
              <span class="tile-desc">{app.description}</span>
            </div>
          ),
        )
      }
    </section>

    <footer>
      <p>© {new Date().getFullYear()} Killterm</p>
    </footer>
  </main>
</Layout>

<script>
  import { createLiquidGlassFilter, supportsLiquidGlass } from '../lib/liquid-glass';

  // 굴절은 별도 bend 레이어에 적용하고, 타일에서 발생한 포인터 상태에 맞춰
  // 필터를 교체한다. 미지원 브라우저에서는 CSS blur 폴백을 그대로 사용한다.
  for (const tile of document.querySelectorAll<HTMLElement>('.tile')) {
    if (!supportsLiquidGlass()) break;
    const bend = tile.querySelector<HTMLElement>('.tile-glass-bend')!;
    const rect = bend.getBoundingClientRect();
    const radius = Number.parseFloat(getComputedStyle(tile).borderRadius);
    const geometry = {
      width: Math.round(rect.width),
      height: Math.round(rect.height),
      radius,
      bezel: Math.min(20, radius * 0.75),
    };
    const filters = {
      rest: `url(#${createLiquidGlassFilter(geometry, 12)})`,
      hover: `url(#${createLiquidGlassFilter(geometry, 22)})`,
      pressed: `url(#${createLiquidGlassFilter(geometry, 38)})`,
    };
    const interactive = tile.matches('a.tile');
    let hovered = false;
    let pressed = false;
    const update = () => {
      bend.style.backdropFilter = pressed
        ? filters.pressed
        : hovered
          ? filters.hover
          : filters.rest;
    };
    update();
    if (!interactive) continue;
    tile.addEventListener('pointerenter', () => {
      hovered = true;
      update();
    });
    tile.addEventListener('pointerleave', () => {
      hovered = false;
      pressed = false;
      update();
    });
    tile.addEventListener('pointerdown', () => {
      pressed = true;
      update();
    });
    const release = () => {
      pressed = false;
      update();
    };
    tile.addEventListener('pointerup', release);
    tile.addEventListener('pointercancel', release);
  }
</script>

<style>
  main {
    max-width: 960px;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
  }

  .hero {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    font-size: clamp(2.2rem, 6vw, 3.2rem);
    letter-spacing: -0.02em;
    margin: 0 0 0.75rem;
    background: linear-gradient(135deg, var(--text) 40%, var(--accent));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero p {
    color: var(--text-dim);
    margin: 0;
  }

  .launchpad {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
  }

  /* ---------- 리퀴드 글래스 배경 ----------
     backdrop-filter가 굴절시킬 대상이 있어야 유리 느낌이 나므로
     화면 뒤에 흐릿한 컬러 블롭을 깔아 둔다. */

  .glass-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    width: 45vmax;
    height: 45vmax;
    border-radius: 50%;
    filter: blur(90px);
    opacity: light-dark(0.22, 0.4);
    animation: blob-float 20s ease-in-out infinite alternate;
  }

  .blob-a {
    top: -14%;
    left: -10%;
    background: #4263eb;
  }

  .blob-b {
    bottom: -20%;
    right: -12%;
    background: #7048e8;
    animation-delay: -7s;
  }

  .blob-c {
    top: 28%;
    left: 56%;
    width: 30vmax;
    height: 30vmax;
    background: #0ca678;
    animation-delay: -13s;
  }

  @keyframes blob-float {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(4vmax, -3vmax) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }

  /* ---------- 리퀴드 글래스 타일 ---------- */

  .tile {
    position: relative;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding: 1.25rem;
    text-align: center;
    border: 0;
    border-radius: 1.6rem;
    isolation: isolate;
    text-decoration: none;
  }

  .tile-glass,
  .tile-glass-bend,
  .tile-glass-face,
  .tile-glass-edge {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
  }

  .tile-glass {
    overflow: hidden;
    z-index: 0;
  }

  /* bend: 배경을 굴절시키는 실제 유리층 */
  .tile-glass-bend {
    z-index: 0;
    background: linear-gradient(
      150deg,
      light-dark(rgba(255, 255, 255, 0.42), rgba(255, 255, 255, 0.08)),
      light-dark(rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.025))
    );
    filter: url('#glass-blur');
    backdrop-filter: blur(3px) saturate(145%);
    -webkit-backdrop-filter: blur(3px) saturate(145%);
  }

  .glass-filter {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  /* face: 유리판의 무게와 바닥 그림자 */
  .tile-glass-face {
    z-index: 1;
    box-shadow: 0 10px 34px light-dark(rgba(28, 35, 51, 0.13), rgba(0, 0, 0, 0.36));
    transition: box-shadow 0.22s ease;
  }

  /* edge는 움직이지 않는 내부 굴절광만 표현한다. */
  .tile-glass-edge {
    z-index: 2;
    opacity: 0.68;
    box-shadow:
      inset 3px 3px 3px light-dark(rgba(255, 255, 255, 0.62), rgba(255, 255, 255, 0.3)),
      inset -3px -3px 3px light-dark(rgba(255, 255, 255, 0.38), rgba(255, 255, 255, 0.16));
    transition: opacity 0.22s ease;
  }

  a.tile:hover .tile-glass-face,
  a.tile:focus-visible .tile-glass-face {
    box-shadow: 0 16px 44px light-dark(rgba(28, 35, 51, 0.19), rgba(0, 0, 0, 0.52));
  }

  a.tile:hover .tile-glass-edge,
  a.tile:focus-visible .tile-glass-edge {
    opacity: 1;
  }

  a.tile:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* backdrop-filter 미지원 브라우저는 불투명한 면 색으로 강등 */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .tile-glass-bend {
      background: var(--surface);
    }
  }

  .tile-icon,
  .tile-name,
  .tile-desc {
    position: relative;
    z-index: 3;
  }

  .tile-icon {
    display: grid;
    place-items: center;
    width: 4.4rem;
    height: 4.4rem;
    font-size: 2.2rem;
    line-height: 1;
    margin-bottom: 0.4rem;
    border-radius: 1.35rem;
    background: light-dark(rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0.08));
    border: 1px solid light-dark(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.13));
    box-shadow:
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.2)),
      0 4px 14px light-dark(rgba(28, 35, 51, 0.1), rgba(0, 0, 0, 0.3));
    transition: transform 0.18s ease;
  }

  a.tile:hover .tile-icon,
  a.tile:focus-visible .tile-icon {
    transform: translateY(-2px) scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .tile-icon,
    .tile-glass-edge {
      transition: none;
    }
  }

  .tile-name {
    font-weight: 700;
    font-size: 1.05rem;
  }

  .tile-desc {
    font-size: 0.82rem;
    color: var(--text-dim);
    line-height: 1.4;
  }

  .tile-disabled {
    opacity: 0.45;
    cursor: default;
  }

  footer {
    margin-top: 4rem;
    text-align: center;
    color: var(--text-dim);
    font-size: 0.85rem;
  }
</style>
