---
import Layout from '../layouts/Layout.astro';
import GlassSlider from '../components/GlassSlider.astro';
import { PARAM_GROUPS, defaultParams } from '../lib/sfx-synth';

const initial = defaultParams();

const WAVES = [
  { value: 'square', label: '⬜ 사각파' },
  { value: 'sawtooth', label: '📐 톱니파' },
  { value: 'sine', label: '〰️ 사인파' },
  { value: 'triangle', label: '🔺 삼각파' },
  { value: 'noise', label: '🌫️ 노이즈' },
];

const PRESETS = [
  { id: 'coin', label: '🪙 동전' },
  { id: 'laser', label: '🔫 레이저' },
  { id: 'explosion', label: '💥 폭발' },
  { id: 'powerup', label: '⚡ 파워업' },
  { id: 'hit', label: '💢 피격' },
  { id: 'jump', label: '🦘 점프' },
  { id: 'blip', label: '🔘 블립' },
];
---

<Layout
  title="레트로 SFX 생성기 — Killterm"
  description="8비트 게임 효과음을 파라미터 합성으로 만들고 WAV로 저장합니다."
>
  <main>
    <nav class="top">
      <a href="/">← 홈으로</a>
    </nav>

    <header class="intro">
      <h1>🔊 레트로 SFX 생성기</h1>
      <p>
        동전·레이저·폭발 같은 8비트 게임 효과음을 만들어 WAV로 저장하세요. 프리셋은 누를
        때마다 같은 계열의 다른 소리가 나옵니다. 모든 소리는 브라우저 안에서 합성되며
        서버로 전송되지 않습니다.
      </p>
      <details class="explain">
        <summary>🔍 소리가 어떻게 만들어지나요? (원본 오디오 파일 없음)</summary>
        <p>이 페이지의 소리는 녹음된 샘플의 재생이 아니라 수식으로 즉석에서 합성됩니다.</p>
        <ol>
          <li>
            <b>오실레이터</b> — 사각파·톱니파·사인파·노이즈 파형을 수식으로 직접 샘플
            배열에 씁니다. 예를 들어 사각파는 "주기의 앞부분이면 +, 뒷부분이면 −" 수준의
            계산입니다.
          </li>
          <li>
            <b>모듈레이션</b> — 피치 슬라이드(점프는 위로, 레이저는 아래로), 비브라토,
            아르페지오(동전의 "삐리링"), 필터를 시간축에 겁니다.
          </li>
          <li>
            <b>엔벨로프</b> — attack/sustain/decay 볼륨 곡선을 씌우면 완성입니다.
          </li>
        </ol>
        <p>
          파라미터 모델은 <a
            href="https://www.drpetter.se/project_sfxr.html"
            target="_blank"
            rel="noopener noreferrer">sfxr</a
          >(DrPetter, 2007)와 그 계보(Bfxr·jsfxr)를 따릅니다.
        </p>
      </details>
    </header>

    <section class="controls">
      <div class="field-row">
        <span class="row-label">프리셋</span>
        {
          PRESETS.map((preset) => (
            <button class="btn btn-small preset" data-preset={preset.id} type="button">
              {preset.label}
            </button>
          ))
        }
        <button id="random-button" class="btn btn-small" type="button">🎲 랜덤</button>
        <button id="mutate-button" class="btn btn-small" type="button">🧬 변형</button>
      </div>

      <div class="field-row">
        <span class="row-label">파형</span>
        {
          WAVES.map((wave) => (
            <button
              class="btn btn-small wave"
              data-wave={wave.value}
              aria-pressed={wave.value === initial.waveType ? 'true' : 'false'}
              type="button"
            >
              {wave.label}
            </button>
          ))
        }
      </div>
    </section>

    <section class="player">
      <canvas id="wave-canvas" height="120"></canvas>
      <div class="field-row">
        <button id="play-button" class="btn btn-primary" type="button">▶ 재생</button>
        <label class="check-field">
          <input type="checkbox" id="autoplay-toggle" checked />
          조작 시 자동 재생
        </label>
        <span class="sound-indicator" id="sound-indicator"></span>
      </div>
      <div class="field-row">
        <span class="row-label">볼륨</span>
        <GlassSlider id="volume-slider" min="0" max="100" step="1" value="80" aria-label="볼륨" />
        <span class="param-value" id="volume-value">80%</span>
        <button id="export-wav" class="btn btn-small" type="button">💾 WAV 다운로드</button>
      </div>
      <div class="field-row">
        <span class="row-label">보관함</span>
        <input id="sound-name" class="name-input" type="text" placeholder="소리 이름" />
        <button id="save-sound" class="btn btn-small" type="button">🎹 보관함에 저장</button>
        <select id="stored-select" aria-label="저장된 소리"></select>
        <button id="load-sound" class="btn btn-small" type="button">불러오기</button>
        <button id="delete-sound" class="btn btn-small" type="button">삭제</button>
      </div>
      <p class="hint">
        저장한 소리는 <a href="/composer/">칩튠 작곡기</a>에서 악기로 쓸 수 있어요. (이
        브라우저에만 저장됩니다)
      </p>
    </section>

    <section class="params">
      {
        PARAM_GROUPS.map((group) => (
          <div class="param-group">
            <h2>{group.title}</h2>
            {group.params.map((param) => (
              <label class="param-row">
                <span class="param-name">{param.label}</span>
                <GlassSlider
                  id={`param-${param.key}`}
                  min={param.min}
                  max={1}
                  step={0.01}
                  value={initial[param.key]}
                  aria-label={param.label}
                />
                <span class="param-value" data-value-for={param.key}>
                  {initial[param.key].toFixed(2)}
                </span>
              </label>
            ))}
          </div>
        ))
      }
    </section>

    <p id="status" class="status" role="status"></p>
  </main>
</Layout>

<script>
  import {
    PARAM_GROUPS,
    SAMPLE_RATE,
    defaultParams,
    mutate,
    presetBlip,
    presetCoin,
    presetExplosion,
    presetHit,
    presetJump,
    presetLaser,
    presetPowerup,
    randomize,
    synthesize,
    type SfxParams,
    type WaveType,
  } from '../lib/sfx-synth';
  import { encodeWav } from '../lib/wav-encode';
  import { deleteSound, listSounds, saveSound } from '../lib/sfx-store';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const waveCanvas = el<HTMLCanvasElement>('wave-canvas');
  const playButton = el<HTMLButtonElement>('play-button');
  const autoplayToggle = el<HTMLInputElement>('autoplay-toggle');
  const soundIndicator = el<HTMLSpanElement>('sound-indicator');
  const volumeSlider = el<HTMLInputElement>('volume-slider');
  const volumeValue = el<HTMLSpanElement>('volume-value');
  const status = el<HTMLParagraphElement>('status');

  const PRESET_MAKERS: Record<string, () => SfxParams> = {
    coin: presetCoin,
    laser: presetLaser,
    explosion: presetExplosion,
    powerup: presetPowerup,
    hit: presetHit,
    jump: presetJump,
    blip: presetBlip,
  };

  // ---------- 상태 ----------

  let params = defaultParams();
  let samples: Float32Array | null = null;
  // 다운로드 파일명에 쓰는 현재 소리의 계열 (프리셋 id | random | custom)
  let soundKind = 'coin';

  // ---------- 재생 ----------

  // AudioContext는 자동재생 정책 때문에 첫 사용자 제스처에서 lazy 생성한다
  let audioContext: AudioContext | null = null;

  function playSamples() {
    if (!samples || samples.length === 0) return;
    audioContext ??= new AudioContext();
    if (audioContext.state === 'suspended') void audioContext.resume();
    const buffer = audioContext.createBuffer(1, samples.length, SAMPLE_RATE);
    buffer.copyToChannel(samples, 0);
    const source = audioContext.createBufferSource();
    source.buffer = buffer;
    const gain = audioContext.createGain();
    gain.gain.value = Number(volumeSlider.value) / 100;
    source.connect(gain).connect(audioContext.destination);
    source.start();
  }

  // ---------- 파형 미리보기 ----------

  function drawWaveform() {
    const width = waveCanvas.clientWidth;
    const height = waveCanvas.clientHeight;
    const ratio = window.devicePixelRatio || 1;
    waveCanvas.width = width * ratio;
    waveCanvas.height = height * ratio;
    const context = waveCanvas.getContext('2d')!;
    context.scale(ratio, ratio);
    context.clearRect(0, 0, width, height);

    const styles = getComputedStyle(document.documentElement);
    context.strokeStyle = styles.getPropertyValue('--accent').trim() || '#4263eb';
    context.globalAlpha = 0.35;
    context.beginPath();
    context.moveTo(0, height / 2);
    context.lineTo(width, height / 2);
    context.stroke();
    context.globalAlpha = 1;

    if (!samples || samples.length === 0) return;
    // 픽셀 열마다 구간의 최소/최대를 세로선으로 그린다 (샘플 수 >> 픽셀 수)
    context.beginPath();
    for (let x = 0; x < width; x++) {
      const start = Math.floor((x / width) * samples.length);
      const end = Math.max(start + 1, Math.floor(((x + 1) / width) * samples.length));
      let min = 1;
      let max = -1;
      for (let i = start; i < end; i++) {
        if (samples[i] < min) min = samples[i];
        if (samples[i] > max) max = samples[i];
      }
      context.moveTo(x + 0.5, ((1 - max) / 2) * height);
      context.lineTo(x + 0.5, ((1 - min) / 2) * height);
    }
    context.stroke();
  }

  // ---------- 합성 ----------

  function regenerate(playAfter: boolean) {
    status.textContent = '';
    samples = synthesize(params);
    if (samples.length === 0) {
      soundIndicator.textContent = '';
      drawWaveform();
      status.textContent =
        '소리 길이가 0입니다. 주파수 최저 한계가 시작 주파수보다 높으면 즉시 종료됩니다.';
      return;
    }
    soundIndicator.textContent = `${(samples.length / SAMPLE_RATE).toFixed(2)}초 · ${samples.length.toLocaleString()} 샘플`;
    drawWaveform();
    if (playAfter && autoplayToggle.checked) playSamples();
  }

  // ---------- 파라미터 ↔ UI ----------

  function formatValue(value: number) {
    return value.toFixed(2);
  }

  function syncInputsFromParams() {
    for (const group of PARAM_GROUPS) {
      for (const meta of group.params) {
        const input = el<HTMLInputElement>(`param-${meta.key}`);
        input.value = String(params[meta.key]);
        document.querySelector(`[data-value-for="${meta.key}"]`)!.textContent = formatValue(
          params[meta.key],
        );
      }
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>('.wave')) {
      button.setAttribute('aria-pressed', String(button.dataset.wave === params.waveType));
    }
  }

  for (const group of PARAM_GROUPS) {
    for (const meta of group.params) {
      const input = el<HTMLInputElement>(`param-${meta.key}`);
      // 드래그 중에는 파형만 갱신하고, 재생은 놓는 순간(change)에 한 번만 한다
      input.addEventListener('input', () => {
        const value = Number(input.value);
        params[meta.key] = value;
        document.querySelector(`[data-value-for="${meta.key}"]`)!.textContent =
          formatValue(value);
        soundKind = 'custom';
        regenerate(false);
      });
      input.addEventListener('change', () => {
        if (autoplayToggle.checked) playSamples();
      });
    }
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.wave')) {
    button.addEventListener('click', () => {
      params.waveType = button.dataset.wave as WaveType;
      soundKind = 'custom';
      syncInputsFromParams();
      regenerate(true);
    });
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('.preset')) {
    button.addEventListener('click', () => {
      const id = button.dataset.preset!;
      params = PRESET_MAKERS[id]();
      soundKind = id;
      syncInputsFromParams();
      regenerate(true);
    });
  }

  el<HTMLButtonElement>('random-button').addEventListener('click', () => {
    params = randomize();
    soundKind = 'random';
    syncInputsFromParams();
    regenerate(true);
  });

  el<HTMLButtonElement>('mutate-button').addEventListener('click', () => {
    params = mutate(params);
    syncInputsFromParams();
    regenerate(true);
  });

  playButton.addEventListener('click', () => {
    if (!samples) regenerate(false);
    playSamples();
  });

  volumeSlider.addEventListener('input', () => {
    volumeValue.textContent = `${volumeSlider.value}%`;
  });

  el<HTMLButtonElement>('export-wav').addEventListener('click', () => {
    if (!samples || samples.length === 0) return;
    // 볼륨은 재생과 동일하게 내보내기에도 반영한다
    const volume = Number(volumeSlider.value) / 100;
    const scaled = new Float32Array(samples.length);
    for (let i = 0; i < samples.length; i++) scaled[i] = samples[i] * volume;
    const blob = new Blob([encodeWav(scaled, SAMPLE_RATE)], { type: 'audio/wav' });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = `sfx-${soundKind}.wav`;
    anchor.click();
    URL.revokeObjectURL(url);
  });

  // ---------- 보관함 ----------

  const soundNameInput = el<HTMLInputElement>('sound-name');
  const storedSelect = el<HTMLSelectElement>('stored-select');
  const loadButton = el<HTMLButtonElement>('load-sound');
  const deleteButton = el<HTMLButtonElement>('delete-sound');

  function refreshStoredList(selectedId?: string) {
    const sounds = listSounds();
    storedSelect.innerHTML = '';
    if (sounds.length === 0) {
      const option = document.createElement('option');
      option.textContent = '(저장된 소리 없음)';
      option.value = '';
      storedSelect.append(option);
    } else {
      for (const sound of sounds) {
        const option = document.createElement('option');
        option.value = sound.id;
        option.textContent = sound.name;
        storedSelect.append(option);
      }
      if (selectedId) storedSelect.value = selectedId;
    }
    storedSelect.disabled = sounds.length === 0;
    loadButton.disabled = sounds.length === 0;
    deleteButton.disabled = sounds.length === 0;
  }

  el<HTMLButtonElement>('save-sound').addEventListener('click', () => {
    const name = soundNameInput.value.trim() || `${soundKind}-${listSounds().length + 1}`;
    const sound = saveSound(name, params);
    soundNameInput.value = '';
    refreshStoredList(sound.id);
    status.textContent = '';
    soundIndicator.textContent = `"${name}" 저장됨`;
  });

  loadButton.addEventListener('click', () => {
    const sound = listSounds().find((item) => item.id === storedSelect.value);
    if (!sound) return;
    params = { ...sound.params };
    soundKind = 'custom';
    syncInputsFromParams();
    regenerate(true);
  });

  deleteButton.addEventListener('click', () => {
    const sound = listSounds().find((item) => item.id === storedSelect.value);
    if (!sound) return;
    deleteSound(sound.id);
    refreshStoredList();
  });

  refreshStoredList();

  // 테마 전환 시 파형 색을 다시 읽는다
  new MutationObserver(() => drawWaveform()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
  window.addEventListener('resize', drawWaveform);

  // 첫 화면: 동전 소리를 만들어 파형을 보여준다 (제스처 전이므로 재생은 안 함)
  params = presetCoin();
  soundKind = 'coin';
  syncInputsFromParams();
  regenerate(false);
</script>

<style>
  main {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }

  .top a {
    color: var(--text-dim);
    text-decoration: none;
  }

  .top a:hover {
    color: var(--accent);
  }

  .intro h1 {
    margin: 1rem 0 0.6rem;
  }

  .intro p {
    color: var(--text-dim);
    line-height: 1.6;
    margin: 0 0 0.8rem;
  }

  .explain {
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: var(--bg-soft);
    padding: 0.7rem 1rem;
    margin-bottom: 0.5rem;
  }

  .explain summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--text);
  }

  .explain p,
  .explain li {
    color: var(--text-dim);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .explain ol {
    padding-left: 1.3rem;
    margin: 0.5rem 0;
  }

  .explain a {
    color: var(--accent);
  }

  .controls,
  .player {
    display: grid;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .field-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .row-label {
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 600;
    min-width: 3.2rem;
  }

  #wave-canvas {
    width: 100%;
    height: 120px;
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    background: var(--bg-soft);
  }

  .sound-indicator {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.88rem;
    color: var(--text-dim);
  }

  .check-field {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .name-input,
  #stored-select {
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.3rem 0.5rem;
    border-radius: 0.5rem;
  }

  .name-input {
    width: 9rem;
  }

  .name-input:focus,
  #stored-select:focus {
    outline: 2px solid var(--accent);
    border-color: var(--accent);
  }

  #stored-select:disabled,
  .btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .hint {
    color: var(--text-dim);
    font-size: 0.82rem;
    margin: 0;
  }

  .hint a {
    color: var(--accent);
  }

  /* ---------- 파라미터 슬라이더 ---------- */

  .params {
    margin-top: 1.6rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 0.9rem 1.4rem;
    align-items: start;
  }

  .param-group {
    border: 1px solid var(--border);
    border-radius: 0.9rem;
    padding: 0.8rem 1rem 0.9rem;
  }

  .param-group h2 {
    font-size: 0.9rem;
    color: var(--text-dim);
    margin: 0 0 0.4rem;
  }

  .param-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .param-name {
    flex: 0 0 10.5rem;
    color: var(--text-dim);
    font-size: 0.84rem;
  }

  .param-value {
    flex: 0 0 2.8rem;
    text-align: right;
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.84rem;
    color: var(--text-dim);
  }

  /* ---------- 공용 프리미티브 (페이지 스코프 복제) ---------- */

  .btn {
    appearance: none;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 0.7rem;
    cursor: pointer;
  }

  .btn:hover {
    border-color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .btn-small {
    padding: 0.3rem 0.7rem;
    font-size: 0.82rem;
  }

  .wave[aria-pressed='true'] {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .status {
    min-height: 1.2em;
    margin: 0.8rem 0 0;
    font-size: 0.88rem;
    color: var(--danger);
    overflow-wrap: anywhere;
  }
</style>
