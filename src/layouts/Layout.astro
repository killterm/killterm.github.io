---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Killterm의 작은 도구 모음' } = Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      // FOUC 방지: 저장된 테마 선택을 스타일 적용 전에 반영 (없으면 OS 설정 추종)
      const storedTheme = localStorage.getItem('killterm-theme');
      if (storedTheme === 'light' || storedTheme === 'dark') {
        document.documentElement.dataset.theme = storedTheme;
      }
    </script>
  </head>
  <body>
    <button id="theme-toggle" type="button" aria-label="테마 전환">
      <span id="theme-toggle-icon" aria-hidden="true">🌙</span>
    </button>
    <slot />
  </body>
</html>

<script>
  import { applyLiquidGlass } from '../lib/liquid-glass';

  const toggleButton = document.getElementById('theme-toggle') as HTMLButtonElement;
  const systemLight = window.matchMedia('(prefers-color-scheme: light)');

  // 유효 테마 = 명시적 선택(data-theme) ?? OS 설정
  const effectiveTheme = () =>
    document.documentElement.dataset.theme ?? (systemLight.matches ? 'light' : 'dark');

  const toggleIcon = document.getElementById('theme-toggle-icon') as HTMLSpanElement;

  function renderToggle() {
    const theme = effectiveTheme();
    toggleIcon.textContent = theme === 'dark' ? '🌙' : '☀️';
    toggleButton.setAttribute(
      'aria-label',
      theme === 'dark' ? '라이트 모드로 전환' : '다크 모드로 전환',
    );
  }

  toggleButton.addEventListener('click', () => {
    const next = effectiveTheme() === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    localStorage.setItem('killterm-theme', next);
    renderToggle();
  });

  // 명시적 선택 전에는 OS 테마 변경도 아이콘에 반영
  systemLight.addEventListener('change', renderToggle);
  renderToggle();

  // 테마 토글을 리퀴드 글래스(굴절)로. 누르면 굴절이 강해진다.
  // 미지원 브라우저는 CSS 폴백(blur) 유지
  const toggleRadius = toggleButton.getBoundingClientRect().width / 2;
  applyLiquidGlass(toggleButton, {
    radius: toggleRadius,
    bezel: toggleRadius * 0.8,
    strength: 24,
    hoverStrength: 44,
    pressedStrength: 72,
  });

  // 외부 도메인으로 가는 모든 링크에 출처(utm_source)를 자동으로 붙인다.
  // 페이지의 링크는 전부 정적이므로 로드 시 한 번 순회하면 충분하다.
  for (const anchor of document.querySelectorAll<HTMLAnchorElement>('a[href^="http"]')) {
    const url = new URL(anchor.href);
    if (url.host === location.host) continue;
    url.searchParams.set('utm_source', 'killterm.github.io');
    anchor.href = url.toString();
  }
</script>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  :root {
    color-scheme: dark;
    --bg: #0f1117;
    --bg-soft: #171a23;
    --surface: #1e222e;
    --border: #2c3140;
    --text: #e8eaf0;
    --text-dim: #9aa1b2;
    --accent: #6c8cff;
    --accent-soft: rgba(108, 140, 255, 0.14);
    --danger: #ff8f8f;
  }

  /* 라이트 팔레트: 수동 선택(data-theme) 또는 OS 설정 추종(명시 선택 없을 때) */
  :root[data-theme='light'] {
    color-scheme: light;
    --bg: #f5f6f8;
    --bg-soft: #eceef2;
    --surface: #ffffff;
    --border: #d5d9e2;
    --text: #1c2333;
    --text-dim: #5b6270;
    --accent: #4263eb;
    --accent-soft: rgba(66, 99, 235, 0.12);
    --danger: #c92a2a;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      color-scheme: light;
      --bg: #f5f6f8;
      --bg-soft: #eceef2;
      --surface: #ffffff;
      --border: #d5d9e2;
      --text: #1c2333;
      --text-dim: #5b6270;
      --accent: #4263eb;
      --accent-soft: rgba(66, 99, 235, 0.12);
      --danger: #c92a2a;
    }
  }

  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family:
      'Pretendard Variable',
      Pretendard,
      -apple-system,
      BlinkMacSystemFont,
      'Segoe UI',
      'Malgun Gothic',
      '맑은 고딕',
      sans-serif;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  #theme-toggle {
    position: fixed;
    top: 1rem;
    right: 1rem;
    z-index: 100;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    background: light-dark(rgba(255, 255, 255, 0.4), rgba(255, 255, 255, 0.08));
    border: 1px solid light-dark(rgba(255, 255, 255, 0.85), rgba(255, 255, 255, 0.25));
    border-radius: 50%;
    box-shadow:
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.28)),
      0 4px 14px light-dark(rgba(28, 35, 51, 0.15), rgba(0, 0, 0, 0.35));
    backdrop-filter: blur(10px) saturate(150%);
    -webkit-backdrop-filter: blur(10px) saturate(150%);
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  /* backdrop-filter 요소에 transform을 걸면 필터링된 사각 영역이 뒤 배경과
     어긋나 그대로 드러나므로, 움직임 효과는 안쪽 아이콘에만 준다 */
  #theme-toggle-icon {
    display: block;
    transition: transform 0.15s ease;
  }

  /* 호버: 색 테두리 대신 유리 하이라이트가 밝아지는 반응 */
  #theme-toggle:hover {
    border-color: light-dark(rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.5));
    box-shadow:
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.5)),
      inset 0 -10px 14px -10px light-dark(rgba(255, 255, 255, 0.9), rgba(255, 255, 255, 0.3)),
      0 6px 20px light-dark(rgba(28, 35, 51, 0.22), rgba(0, 0, 0, 0.45));
  }

  #theme-toggle:hover #theme-toggle-icon {
    transform: rotate(15deg);
  }

  #theme-toggle:active #theme-toggle-icon {
    transform: scale(0.85);
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
  }
</style>
