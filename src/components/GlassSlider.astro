---
// 리퀴드 글래스 썸을 가진 공용 range 슬라이더.
//
// ::-webkit-slider-thumb 같은 가상 요소에는 SVG 참조 backdrop-filter가 적용되지
// 않으므로, 네이티브 썸은 투명하게 두고(드래그 대상 역할만) 진짜 DOM 요소 썸을
// 위에 겹쳐 표시한다. 썸 위치는 CSS calc로 계산해 리사이즈에도 JS 없이 따라온다.
//
// 썸 굴절은 Chromium 전용이고, 그 외 브라우저는 반투명 + blur 폴백으로 강등된다.
interface Props {
  id: string;
  min: number | string;
  max: number | string;
  step?: number | string;
  value: number | string;
  'aria-label'?: string;
}

const { id, min, max, step = 1, value, 'aria-label': ariaLabel } = Astro.props;
const initialRatio = (Number(value) - Number(min)) / (Number(max) - Number(min) || 1);
// 썸 크기(px). 스크립트·스타일의 값과 일치해야 한다.
const THUMB_WIDTH = 40;
---

<span class="glass-slider">
  <input
    type="range"
    id={id}
    min={min}
    max={max}
    step={step}
    value={value}
    aria-label={ariaLabel}
  />
  <span
    class="glass-slider-thumb"
    style={`left: calc(${initialRatio} * (100% - ${THUMB_WIDTH}px))`}
    aria-hidden="true"></span>
</span>

<script>
  import { createLiquidGlassFilter, supportsLiquidGlass } from '../lib/liquid-glass';

  // 모든 글래스 슬라이더의 썸은 같은 기하학(40×26 알약)이라 필터를 공유한다.
  // 드래그 중에는 굴절이 강한 필터로 교체해 눌린 유리 느낌을 낸다.
  const THUMB_WIDTH = 40;
  const geometry = { width: THUMB_WIDTH, height: 26, radius: 13, bezel: 11 };
  let restFilter = '';
  let pressedFilter = '';
  if (supportsLiquidGlass()) {
    restFilter = `url(#${createLiquidGlassFilter(geometry, 18)})`;
    pressedFilter = `url(#${createLiquidGlassFilter(geometry, 56)})`;
  }

  for (const wrap of document.querySelectorAll<HTMLElement>('.glass-slider')) {
    const input = wrap.querySelector('input')!;
    const thumb = wrap.querySelector<HTMLElement>('.glass-slider-thumb')!;
    if (restFilter) thumb.style.backdropFilter = restFilter;

    const positionThumb = () => {
      const min = Number(input.min);
      const max = Number(input.max);
      const ratio = (Number(input.value) - min) / (max - min || 1);
      thumb.style.left = `calc(${ratio} * (100% - ${THUMB_WIDTH}px))`;
    };

    // 페이지 스크립트가 value를 직접 대입해도 썸이 따라오도록 setter를 가로챈다
    const descriptor = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, 'value')!;
    Object.defineProperty(input, 'value', {
      get() {
        return descriptor.get!.call(this);
      },
      set(next) {
        descriptor.set!.call(this, next);
        positionThumb();
      },
    });

    input.addEventListener('input', positionThumb);

    input.addEventListener('pointerdown', () => {
      thumb.classList.add('pressed');
      if (pressedFilter) thumb.style.backdropFilter = pressedFilter;
      // 드래그가 슬라이더 밖으로 나가면 브라우저가 텍스트 선택 제스처로
      // 해석하므로, 드래그 동안에는 문서 전체의 선택을 잠시 막는다
      document.body.style.userSelect = 'none';
    });
    const release = () => {
      thumb.classList.remove('pressed');
      if (restFilter) thumb.style.backdropFilter = restFilter;
      document.body.style.userSelect = '';
    };
    input.addEventListener('pointerup', release);
    input.addEventListener('pointercancel', release);
  }
</script>

<style>
  .glass-slider {
    position: relative;
    display: inline-block;
    /* flex 행 안에서 남는 좌우 폭을 최대한 차지한다 */
    flex: 1 1 220px;
    min-width: 180px;
    height: 30px;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .glass-slider input {
    -webkit-appearance: none;
    appearance: none;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    background: transparent;
  }

  .glass-slider input::-webkit-slider-runnable-track {
    height: 8px;
    border-radius: 999px;
    background: light-dark(rgba(28, 35, 51, 0.12), rgba(255, 255, 255, 0.12));
    border: 1px solid light-dark(rgba(28, 35, 51, 0.18), rgba(255, 255, 255, 0.14));
  }

  /* 네이티브 썸은 보이지 않게 하되 크기는 유지해 드래그 대상이 되게 한다 */
  .glass-slider input::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 40px;
    height: 26px;
    margin-top: -9px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  .glass-slider input::-moz-range-track {
    height: 8px;
    border-radius: 999px;
    background: light-dark(rgba(28, 35, 51, 0.12), rgba(255, 255, 255, 0.12));
    border: 1px solid light-dark(rgba(28, 35, 51, 0.18), rgba(255, 255, 255, 0.14));
  }

  .glass-slider input::-moz-range-thumb {
    width: 40px;
    height: 26px;
    background: transparent;
    border: none;
    cursor: pointer;
  }

  /* Chromium은 range input에 마우스 포커스여도 :focus-visible을 적용하므로
     박스 전체 아웃라인 대신 썸에만 포커스 링을 그린다 (키보드 조작 시에도 표시) */
  .glass-slider input:focus-visible {
    outline: none;
  }

  .glass-slider input:focus-visible + .glass-slider-thumb {
    box-shadow:
      0 0 0 2px var(--accent),
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.4)),
      0 2px 8px light-dark(rgba(28, 35, 51, 0.25), rgba(0, 0, 0, 0.4));
  }

  .glass-slider-thumb {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    width: 40px;
    height: 26px;
    border-radius: 999px;
    pointer-events: none;
    background: light-dark(rgba(255, 255, 255, 0.45), rgba(255, 255, 255, 0.16));
    border: 1px solid light-dark(rgba(255, 255, 255, 0.95), rgba(255, 255, 255, 0.4));
    box-shadow:
      inset 0 1px 0 light-dark(rgba(255, 255, 255, 1), rgba(255, 255, 255, 0.4)),
      0 2px 8px light-dark(rgba(28, 35, 51, 0.25), rgba(0, 0, 0, 0.4));
    backdrop-filter: blur(6px) saturate(150%);
    -webkit-backdrop-filter: blur(6px) saturate(150%);
    transition: scale 0.12s ease;
  }

  .glass-slider-thumb.pressed {
    scale: 1.45;
  }
</style>
