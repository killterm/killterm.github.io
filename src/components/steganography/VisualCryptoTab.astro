---
// 시각 암호: 비밀 그림을 조각 두 장으로 나누고, 겹쳐야 보이게 한다.
import '../../styles/steganography.css';
---

<div class="steganography">
  <div class="cards">
    <section class="card" aria-labelledby="vc-split-title">
      <h2 id="vc-split-title">나누기</h2>
      <p class="desc">
        비밀 그림을 무작위로 보이는 조각 두 장으로 나눕니다. 한 장만으로는
        <strong>아무 정보도 얻을 수 없습니다</strong> — 계산상 어려운 게 아니라 원리적으로 불가능합니다.
      </p>

      <div class="chip-group" role="radiogroup" aria-label="입력 방식">
        <label class="chip">
          <input type="radio" name="vc-source" value="text" checked />
          <span>글자</span>
        </label>
        <label class="chip">
          <input type="radio" name="vc-source" value="image" />
          <span>이미지</span>
        </label>
      </div>

      <input id="vc-word" type="text" value="SECRET" maxlength="10" aria-label="비밀 글자" />
      <label class="file-row" id="vc-image-row" hidden>
        <span>비밀 이미지</span>
        <input id="vc-image" type="file" accept="image/*" />
      </label>

      <label class="num-field">
        흑백 기준
        <input id="vc-threshold" type="number" min="16" max="240" step="8" value="128" />
      </label>

      <canvas id="vc-secret" class="preview" hidden></canvas>
      <button id="vc-split" class="btn btn-primary" type="button">조각 2장 만들기</button>
      <div class="shares" id="vc-shares" hidden>
        <figure>
          <canvas id="vc-share1" class="preview"></canvas>
          <figcaption>조각 1</figcaption>
        </figure>
        <figure>
          <canvas id="vc-share2" class="preview"></canvas>
          <figcaption>조각 2</figcaption>
        </figure>
      </div>
      <p id="vc-split-status" class="status" role="status"></p>
    </section>

    <section class="card" aria-labelledby="vc-merge-title">
      <h2 id="vc-merge-title">겹치기</h2>
      <p class="desc">조각 두 장을 골라 겹치면 비밀 그림이 드러납니다.</p>

      <label class="file-row">
        <span>조각 1</span>
        <input id="vc-first" type="file" accept="image/png" />
      </label>
      <label class="file-row">
        <span>조각 2</span>
        <input id="vc-second" type="file" accept="image/png" />
      </label>

      <canvas id="vc-overlay" class="preview" hidden></canvas>
      <button id="vc-clean" class="btn btn-small" type="button" hidden>또렷하게 정리</button>
      <p id="vc-merge-status" class="status" role="status"></p>
    </section>
  </div>

  <section class="notes">
    <h2>참고</h2>
    <ul>
      <li>
        <strong>Naor–Shamir 2-of-2 방식</strong>입니다(1994). 픽셀 하나를 2×2 점으로 늘려서, 흰
        픽셀은 두 조각에 같은 무늬를, 검은 픽셀은 서로 반대 무늬를 넣습니다. 겹치면 검은 픽셀만 완전히
        까맣게 되어 그림이 보입니다.
      </li>
      <li>
        조각을 <strong>투명 필름에 인쇄해 겹쳐도 보입니다.</strong> 컴퓨터 없이 눈만으로 복호되는
        것이 이 기법의 매력입니다.
      </li>
      <li>
        겹친 그림은 원래보다 어둡고 흐릿합니다(흰 부분도 절반은 검게 되기 때문). "또렷하게 정리"를
        누르면 2×2 블록을 다시 판정해 원본 크기로 복원합니다.
      </li>
      <li>
        조각은 원본의 2배 크기가 되고, 반드시 <strong>PNG처럼 무손실 형식</strong>으로 주고받아야
        합니다 — JPEG로 저장하면 점 무늬가 뭉개져 복원되지 않습니다.
      </li>
    </ul>
  </section>
</div>

<script>
  import { overlayShares, recoverFromOverlay, splitShares } from '../../lib/visual-crypto';
  import { downloadBlob } from '../../lib/file-io';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const wordInput = el<HTMLInputElement>('vc-word');
  const imageRow = el<HTMLLabelElement>('vc-image-row');
  const imageInput = el<HTMLInputElement>('vc-image');
  const thresholdInput = el<HTMLInputElement>('vc-threshold');
  const secretCanvas = el<HTMLCanvasElement>('vc-secret');
  const sharesBox = el<HTMLDivElement>('vc-shares');
  const share1Canvas = el<HTMLCanvasElement>('vc-share1');
  const share2Canvas = el<HTMLCanvasElement>('vc-share2');
  const splitStatus = el<HTMLParagraphElement>('vc-split-status');
  const firstInput = el<HTMLInputElement>('vc-first');
  const secondInput = el<HTMLInputElement>('vc-second');
  const overlayCanvas = el<HTMLCanvasElement>('vc-overlay');
  const cleanButton = el<HTMLButtonElement>('vc-clean');
  const mergeStatus = el<HTMLParagraphElement>('vc-merge-status');

  const setStatus = (node: HTMLElement, message: string, ok = false) => {
    node.textContent = message;
    node.classList.toggle('status-ok', ok && message !== '');
  };

  const SECRET_WIDTH = 240;
  const SECRET_HEIGHT = 120;

  const sourceMode = () =>
    (document.querySelector('input[name="vc-source"]:checked') as HTMLInputElement).value;

  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="vc-source"]')) {
    radio.addEventListener('change', () => {
      const isText = sourceMode() === 'text';
      wordInput.hidden = !isText;
      imageRow.hidden = isText;
      void updateSecretPreview();
    });
  }

  /** 비밀 그림을 흑백 밝기 배열로 만든다 */
  async function buildSecret(): Promise<Uint8ClampedArray | null> {
    const canvas = document.createElement('canvas');
    canvas.width = SECRET_WIDTH;
    canvas.height = SECRET_HEIGHT;
    const context = canvas.getContext('2d')!;
    context.fillStyle = '#fff';
    context.fillRect(0, 0, SECRET_WIDTH, SECRET_HEIGHT);

    if (sourceMode() === 'text') {
      const word = wordInput.value.trim();
      if (word === '') return null;
      context.fillStyle = '#000';
      context.textAlign = 'center';
      context.textBaseline = 'middle';
      let fontSize = SECRET_HEIGHT * 0.7;
      do {
        context.font = `bold ${fontSize}px sans-serif`;
        fontSize -= 4;
      } while (context.measureText(word).width > SECRET_WIDTH * 0.9 && fontSize > 8);
      context.fillText(word, SECRET_WIDTH / 2, SECRET_HEIGHT / 2);
    } else {
      const file = imageInput.files?.[0];
      if (!file) return null;
      const bitmap = await createImageBitmap(file);
      context.drawImage(bitmap, 0, 0, SECRET_WIDTH, SECRET_HEIGHT);
      bitmap.close();
    }

    const pixels = context.getImageData(0, 0, SECRET_WIDTH, SECRET_HEIGHT);
    const brightness = new Uint8ClampedArray(SECRET_WIDTH * SECRET_HEIGHT);
    for (let i = 0; i < brightness.length; i++) {
      const base = i * 4;
      brightness[i] =
        0.299 * pixels.data[base] + 0.587 * pixels.data[base + 1] + 0.114 * pixels.data[base + 2];
    }
    secretCanvas.width = SECRET_WIDTH;
    secretCanvas.height = SECRET_HEIGHT;
    secretCanvas.getContext('2d')!.putImageData(pixels, 0, 0);
    secretCanvas.hidden = false;
    return brightness;
  }

  async function updateSecretPreview() {
    setStatus(splitStatus, '');
    const secret = await buildSecret();
    if (!secret) secretCanvas.hidden = true;
  }

  wordInput.addEventListener('input', () => void updateSecretPreview());
  imageInput.addEventListener('change', () => void updateSecretPreview());

  function paintShare(canvas: HTMLCanvasElement, data: Uint8ClampedArray, width: number, height: number) {
    canvas.width = width;
    canvas.height = height;
    canvas.getContext('2d')!.putImageData(new ImageData(data, width, height), 0, 0);
  }

  function saveCanvas(canvas: HTMLCanvasElement, filename: string) {
    canvas.toBlob((blob) => {
      if (blob) downloadBlob(blob, filename);
    }, 'image/png');
  }

  el<HTMLButtonElement>('vc-split').addEventListener('click', async () => {
    setStatus(splitStatus, '');
    const secret = await buildSecret();
    if (!secret) {
      setStatus(splitStatus, sourceMode() === 'text' ? '글자를 입력하세요.' : '이미지를 선택하세요.');
      return;
    }
    const threshold = Math.min(240, Math.max(16, Number(thresholdInput.value) || 128));
    const shares = splitShares(secret, SECRET_WIDTH, SECRET_HEIGHT, threshold);
    paintShare(share1Canvas, shares.first, shares.width, shares.height);
    paintShare(share2Canvas, shares.second, shares.width, shares.height);
    sharesBox.hidden = false;
    saveCanvas(share1Canvas, 'share-1.png');
    saveCanvas(share2Canvas, 'share-2.png');
    setStatus(splitStatus, '조각 2장을 저장했습니다. 두 장을 모두 가진 사람만 볼 수 있습니다.', true);
  });

  async function readPixels(file: File): Promise<ImageData> {
    const bitmap = await createImageBitmap(file);
    const canvas = document.createElement('canvas');
    canvas.width = bitmap.width;
    canvas.height = bitmap.height;
    const context = canvas.getContext('2d')!;
    context.drawImage(bitmap, 0, 0);
    bitmap.close();
    return context.getImageData(0, 0, canvas.width, canvas.height);
  }

  let overlaySize: { width: number; height: number } | null = null;

  async function tryOverlay() {
    const firstFile = firstInput.files?.[0];
    const secondFile = secondInput.files?.[0];
    setStatus(mergeStatus, '');
    cleanButton.hidden = true;
    if (!firstFile || !secondFile) return;
    try {
      const [first, second] = await Promise.all([readPixels(firstFile), readPixels(secondFile)]);
      if (first.width !== second.width || first.height !== second.height) {
        setStatus(mergeStatus, '두 조각의 크기가 다릅니다.');
        return;
      }
      const overlay = overlayShares(first.data, second.data);
      if (!overlay) {
        setStatus(mergeStatus, '조각을 겹치지 못했습니다.');
        return;
      }
      overlayCanvas.width = first.width;
      overlayCanvas.height = first.height;
      overlayCanvas
        .getContext('2d')!
        .putImageData(new ImageData(overlay, first.width, first.height), 0, 0);
      overlayCanvas.hidden = false;
      overlaySize = { width: first.width, height: first.height };
      cleanButton.hidden = false;
      setStatus(mergeStatus, '겹쳤습니다. 흐릿하면 "또렷하게 정리"를 눌러보세요.', true);
    } catch (e) {
      setStatus(mergeStatus, e instanceof Error ? e.message : String(e));
    }
  }

  firstInput.addEventListener('change', () => void tryOverlay());
  secondInput.addEventListener('change', () => void tryOverlay());

  cleanButton.addEventListener('click', () => {
    if (!overlaySize) return;
    const context = overlayCanvas.getContext('2d')!;
    const current = context.getImageData(0, 0, overlaySize.width, overlaySize.height);
    const recovered = recoverFromOverlay(current.data, overlaySize.width, overlaySize.height);
    const image = new ImageData(recovered.width, recovered.height);
    for (let i = 0; i < recovered.data.length; i++) {
      const value = recovered.data[i];
      image.data[i * 4] = value;
      image.data[i * 4 + 1] = value;
      image.data[i * 4 + 2] = value;
      image.data[i * 4 + 3] = 255;
    }
    overlayCanvas.width = recovered.width;
    overlayCanvas.height = recovered.height;
    context.putImageData(image, 0, 0);
    cleanButton.hidden = true;
    setStatus(mergeStatus, '원본 크기로 정리했습니다.', true);
  });

  void updateSecretPreview();
</script>

<style>
  /* 카드·참고 레이아웃은 styles/steganography.css에 있다 */
  .num-field {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .num-field input,
  #vc-word {
    border: 1px solid var(--border);
    background: var(--bg-soft);
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
    padding: 0.35rem 0.6rem;
    border-radius: 0.5rem;
  }

  .num-field input {
    width: 4.4rem;
  }

  #vc-word {
    width: 100%;
    font-size: 1rem;
    letter-spacing: 0.08em;
  }

  #vc-word[hidden] {
    display: none;
  }

  .shares {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.7rem;
  }

  .shares[hidden] {
    display: none;
  }

  .shares figure {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }

  .shares figcaption {
    font-size: 0.8rem;
    color: var(--text-dim);
    text-align: center;
  }

  /* 조각의 점 무늬는 보간하면 뭉개진다 */
  .preview {
    image-rendering: pixelated;
    background: #fff;
  }
</style>
