---
// 글 속에 숨기는 세 기법 — 제로폭 문자 · 호모글리프 · 줄 끝 공백.
import '../../styles/steganography.css';
---

<div class="steganography">
  <div class="chip-group technique" role="radiogroup" aria-label="기법 선택">
    <label class="chip">
      <input type="radio" name="text-technique" value="zeroWidth" checked />
      <span>제로폭 문자</span>
    </label>
    <label class="chip">
      <input type="radio" name="text-technique" value="homoglyph" />
      <span>호모글리프</span>
    </label>
    <label class="chip">
      <input type="radio" name="text-technique" value="whitespace" />
      <span>줄 끝 공백</span>
    </label>
  </div>

  <p class="desc technique-desc" id="text-technique-desc"></p>

  <div class="cards">
    <section class="card" aria-labelledby="text-hide-title">
      <h2 id="text-hide-title">숨기기</h2>

      <label class="field-label" for="text-visible">겉보기 문장</label>
      <textarea id="text-visible" rows="3" spellcheck="false"
        >평범해 보이는 문장입니다 여기에 비밀을 숨깁니다</textarea
      >

      <label class="field-label" for="text-secret">숨길 메시지</label>
      <textarea id="text-secret" rows="2" placeholder="숨길 메시지를 입력하세요" spellcheck="false"
      ></textarea>

      <div class="chip-group" id="text-placement-group" role="radiogroup" aria-label="넣을 위치">
        <label class="chip">
          <input type="radio" name="text-placement" value="spread" checked />
          <span>단어 사이 분산</span>
        </label>
        <label class="chip">
          <input type="radio" name="text-placement" value="end" />
          <span>문장 끝</span>
        </label>
      </div>

      <label class="field-label" for="text-output">결과 (복사해서 사용하세요)</label>
      <textarea id="text-output" rows="3" readonly></textarea>
      <div class="row">
        <button class="btn copy" data-target="text-output" type="button">복사</button>
        <span class="detect" id="text-output-info"></span>
      </div>
      <p id="text-hide-status" class="status" role="status"></p>
    </section>

    <section class="card" aria-labelledby="text-find-title">
      <h2 id="text-find-title">찾기</h2>
      <p class="desc">받은 글을 붙여 넣으면 숨어 있는 메시지를 꺼냅니다. 세 기법을 모두 검사합니다.</p>

      <label class="field-label" for="text-input">검사할 글</label>
      <textarea id="text-input" rows="4" placeholder="여기에 붙여 넣으세요" spellcheck="false"
      ></textarea>

      <label class="check-field">
        <input type="checkbox" id="text-visualize" />
        숨은 문자를 기호로 표시
      </label>

      <textarea id="text-visualized" rows="3" readonly hidden></textarea>
      <dl id="text-result" class="result" hidden></dl>
      <textarea id="text-found" rows="3" readonly hidden></textarea>
      <p id="text-find-status" class="status" role="status"></p>
    </section>
  </div>

  <section class="notes">
    <h2>참고</h2>
    <ul>
      <li>
        <strong>제로폭 문자</strong> — 폭이 없는 유니코드 4개(U+200B·U+200C·U+200D·U+2060)로 2비트씩
        표현합니다. 어떤 글에든 원하는 만큼 넣을 수 있지만, 입력값을 정리하는 서비스가 자주 지웁니다.
      </li>
      <li>
        <strong>호모글리프</strong> — 라틴 <code>a</code>를 눈으로 구별할 수 없는 키릴
        <code>а</code>로 바꾸는 식입니다. 글자 수와 모양이 그대로라 필터를 잘 통과하지만, 바꿀 수 있는
        라틴 글자 수만큼만 담깁니다(한글 위주 글에는 거의 못 넣습니다).
        <strong>주의:</strong> 이 성질 때문에 가짜 도메인을 만드는 피싱에 악용되는 기법이기도 합니다.
      </li>
      <li>
        <strong>줄 끝 공백</strong> — 스페이스=0, 탭=1로 줄 끝에 붙입니다. 화면에는 전혀 보이지
        않지만, 편집기·깃 훅이 줄 끝 공백을 자동으로 지우면 함께 사라집니다.
      </li>
      <li>
        어느 기법이든 숨긴 데이터에는 검증용 머리표가 붙어 있어, 우연히 섞인 문자가 메시지로 잘못
        읽히지 않습니다.
      </li>
    </ul>
  </section>
</div>

<script>
  import { frameMessage, parseFrame } from '../../lib/steganography-frame';
  import {
    countHomoglyphs,
    countTrailingWhitespace,
    countZeroWidth,
    fromZeroWidth,
    hideInText,
    homoglyphCapacityBits,
    homoglyphEmbed,
    homoglyphExtract,
    normalizeHomoglyphs,
    stripTrailingWhitespace,
    stripZeroWidth,
    toZeroWidth,
    whitespaceEmbed,
    whitespaceExtract,
    type TextTechnique,
    type ZeroWidthPlacement,
  } from '../../lib/steganography-text';
  import { setupCopyButtons } from '../../lib/copy-buttons';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const techniqueDescription = el<HTMLParagraphElement>('text-technique-desc');
  const visibleArea = el<HTMLTextAreaElement>('text-visible');
  const secretArea = el<HTMLTextAreaElement>('text-secret');
  const placementGroup = el<HTMLDivElement>('text-placement-group');
  const outputArea = el<HTMLTextAreaElement>('text-output');
  const outputInfo = el<HTMLSpanElement>('text-output-info');
  const hideStatus = el<HTMLParagraphElement>('text-hide-status');
  const inputArea = el<HTMLTextAreaElement>('text-input');
  const visualizeToggle = el<HTMLInputElement>('text-visualize');
  const visualizedArea = el<HTMLTextAreaElement>('text-visualized');
  const resultList = el<HTMLDListElement>('text-result');
  const foundArea = el<HTMLTextAreaElement>('text-found');
  const findStatus = el<HTMLParagraphElement>('text-find-status');

  const DESCRIPTIONS: Record<TextTechnique, string> = {
    zeroWidth: '보이지 않는 문자를 글 사이에 끼워 넣습니다. 화면에는 원래 문장만 보입니다.',
    homoglyph:
      '라틴 알파벳을 시각적으로 똑같은 키릴·그리스 문자로 바꿔 비트를 표현합니다. 영문이 많은 글이 필요합니다.',
    whitespace: '줄 끝에 스페이스와 탭을 붙여 비트를 표현합니다. 여러 줄일수록 고르게 퍼집니다.',
  };

  // 가시화용 기호 — 제로폭 4종과 줄 끝 공백을 눈에 보이게 바꿔 보여준다
  const VISIBLE_MARKS: Record<string, string> = {
    '​': '⓪',
    '‌': '①',
    '‍': '②',
    '⁠': '③',
  };

  const technique = () =>
    (document.querySelector('input[name="text-technique"]:checked') as HTMLInputElement)
      .value as TextTechnique;

  const placement = () =>
    (document.querySelector('input[name="text-placement"]:checked') as HTMLInputElement)
      .value as ZeroWidthPlacement;

  const setStatus = (node: HTMLElement, message: string, ok = false) => {
    node.textContent = message;
    node.classList.toggle('status-ok', ok && message !== '');
  };

  function updateOutput() {
    setStatus(hideStatus, '');
    const secret = secretArea.value;
    const current = technique();
    if (secret === '') {
      outputArea.value = visibleArea.value;
      const capacityNote =
        current === 'homoglyph'
          ? ` (이 글에 담을 수 있는 양: ${Math.floor(homoglyphCapacityBits(visibleArea.value) / 8)}바이트)`
          : '';
      outputInfo.textContent = `숨길 메시지를 입력하면 결과가 만들어집니다.${capacityNote}`;
      return;
    }
    const payload = frameMessage({
      kind: 'text',
      name: '',
      data: new TextEncoder().encode(secret),
    });
    try {
      if (current === 'zeroWidth') {
        const hidden = toZeroWidth(payload);
        outputArea.value = hideInText(visibleArea.value, hidden, placement());
        outputInfo.textContent = `숨은 문자 ${hidden.length.toLocaleString()}개 (${payload.length.toLocaleString()}바이트)`;
      } else if (current === 'homoglyph') {
        outputArea.value = homoglyphEmbed(visibleArea.value, payload);
        outputInfo.textContent = `치환된 글자 ${countHomoglyphs(outputArea.value).toLocaleString()}개 / 가능 ${homoglyphCapacityBits(visibleArea.value).toLocaleString()}자 (${payload.length.toLocaleString()}바이트)`;
      } else {
        outputArea.value = whitespaceEmbed(visibleArea.value, payload);
        outputInfo.textContent = `줄 끝 공백 ${countTrailingWhitespace(outputArea.value).toLocaleString()}개 (${payload.length.toLocaleString()}바이트)`;
      }
    } catch (e) {
      outputArea.value = '';
      outputInfo.textContent = '';
      setStatus(hideStatus, e instanceof Error ? e.message : String(e));
    }
  }

  function updateTechnique() {
    techniqueDescription.textContent = DESCRIPTIONS[technique()];
    placementGroup.hidden = technique() !== 'zeroWidth';
    updateOutput();
  }

  function updateFind() {
    const text = inputArea.value;
    resultList.hidden = true;
    foundArea.hidden = true;
    setStatus(findStatus, '');

    if (visualizeToggle.checked && text !== '') {
      visualizedArea.value = text
        .split('\n')
        .map((line) => {
          const trailing = line.match(/[ \t]+$/)?.[0] ?? '';
          const body = trailing ? line.slice(0, -trailing.length) : line;
          const marked = [...body].map((character) => VISIBLE_MARKS[character] ?? character).join('');
          const marks = [...trailing].map((character) => (character === '\t' ? '→' : '·')).join('');
          return marked + marks;
        })
        .join('\n');
      visualizedArea.hidden = false;
    } else {
      visualizedArea.hidden = true;
    }

    if (text === '') return;

    // 세 기법을 모두 시도한다 — 프레임 검증이 통과하는 것만 진짜다
    const attempts = [
      { label: '제로폭 문자', bytes: fromZeroWidth(text), count: countZeroWidth(text) },
      { label: '호모글리프', bytes: homoglyphExtract(text), count: countHomoglyphs(text) },
      { label: '줄 끝 공백', bytes: whitespaceExtract(text), count: countTrailingWhitespace(text) },
    ];
    const found = attempts.map((attempt) => ({ ...attempt, payload: parseFrame(attempt.bytes) }));
    const hit = found.find((attempt) => attempt.payload !== null);

    resultList.innerHTML = '';
    for (const attempt of found) {
      const dt = document.createElement('dt');
      dt.textContent = attempt.label;
      const dd = document.createElement('dd');
      dd.textContent = attempt.payload
        ? `숨은 메시지 발견 (흔적 ${attempt.count.toLocaleString()}개)`
        : attempt.count > 0
          ? `흔적 ${attempt.count.toLocaleString()}개 — 이 도구가 심은 데이터는 아님`
          : '없음';
      resultList.append(dt, dd);
    }
    resultList.hidden = false;

    if (!hit || !hit.payload) {
      setStatus(findStatus, '숨겨진 메시지를 찾지 못했습니다.');
      return;
    }
    foundArea.value = new TextDecoder().decode(hit.payload.data);
    foundArea.hidden = false;
    const plain = stripTrailingWhitespace(normalizeHomoglyphs(stripZeroWidth(text)));
    setStatus(
      findStatus,
      `${hit.label}로 숨긴 메시지를 찾았습니다. (겉보기 글자 ${[...plain].length.toLocaleString()}자)`,
      true,
    );
  }

  for (const node of [visibleArea, secretArea]) {
    node.addEventListener('input', updateOutput);
  }
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="text-technique"]')) {
    radio.addEventListener('change', updateTechnique);
  }
  for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="text-placement"]')) {
    radio.addEventListener('change', updateOutput);
  }
  inputArea.addEventListener('input', updateFind);
  visualizeToggle.addEventListener('change', updateFind);

  setupCopyButtons();
  updateTechnique();
</script>

<style>
  /* 카드·참고 레이아웃은 styles/steganography.css에 있다 */
  .technique {
    margin-bottom: 0.7rem;
  }

  .technique-desc {
    margin-bottom: 1rem;
  }

  .field-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-dim);
    margin-bottom: -0.55rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .check-field {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-dim);
    font-size: 0.85rem;
    cursor: pointer;
  }

  .chip-group[hidden] {
    display: none;
  }

  .notes code {
    font-family: Consolas, 'Courier New', monospace;
    font-size: 0.9em;
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.05rem 0.3rem;
  }

  textarea[hidden] {
    display: none;
  }
</style>
